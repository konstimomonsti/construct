              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Kabelkanal i.F. öffnen, reinigen, schließen  </span>
                <br/>
                <span>MLV-KTB_01201000</span>
               </p>
              </TextOutlTxt>
