         <Item ID="AAAAAAABIMBBECOA" RNoPart="4450">
          <Qty>0.000</Qty>
          <QU>St</QU>
          <Description ID="R20210929061912457000696">
           <WICNo>Muster-LV/20/01.20.4450. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">LWL-Mehrlängenbausatz (Biegeradius 330 mm) als</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Schrank-/ Sockel-Kombination (KVz) Gehäusekörper aus</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Kunststoff (PC), IP 42, unlackiert. Tür mit</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Schwenkhebel vorbereitet für Einsteckschloss passend</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">für den Einbau einer Schließanlage mit der Schließung</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Integriertes Sicherheitsschließsystem der DB Netz AG</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">(ISS-DB Netz) incl. Lieferung und Einbau einer</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">passenden Bauschließung mit Schließzylinder,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Türfeststeller, mit Einbausatz für Kabelvorrat</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">LWL-Kabelmehrlängen mit Biegeradien bis 330 mm</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">(entspricht 60 Fasern), ohne Halterung für eine LWL</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Haubenmuffe, liefern und auf Sockel montieren.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Stecksockel für Erdeinbau aus Kunststoff (PC),</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">vormontiert, unlackiert, mit Kabeleinführungen, mit</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Fixierungspunkten für die Kabelablage und Klettbändern</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">für die Kabelbefestigung liefern und einbauen. Einbau</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">komplett einschl. sämtlicher Befestigungsmaterialien,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Hilfs- und Nebenleistungen entsprechend der</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Einbauvorschrift des Herstellers, einschließlich aller</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">notwendigen Erdarbeiten und Verbau entsprechend</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">statischen und konstruktiven Erfordernissen nach Wahl</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">des AN, überschüssiges Material ist auf Flächen des AN</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">zu transportieren, zur Beprobung abzulegen und bis zum</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Wiedereinbau bzw. der weiteren Verwertung</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">zwischenzulagern. &#x22;</span>
              </p>
             </Text>
            </DetailTxt>
