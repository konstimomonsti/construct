               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">  m , vorhandene</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Dicke über </span>
               <TextComplement MarkLbl="62" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;&#x3e; 45 bis 60&#x3c;&#x27;</span>
                </ComplBody>
                <ComplTail/>
