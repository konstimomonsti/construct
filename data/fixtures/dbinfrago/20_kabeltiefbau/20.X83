            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Umleitungsbausatz 15° für Kabelkanal Gr. IIIa i. F., Einbau in übrigen Bereichen  </span>
