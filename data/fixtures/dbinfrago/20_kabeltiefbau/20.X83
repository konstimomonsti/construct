            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bettung auf dem Bahnkörper bei ausgebautem Gleis und ausgebautem Schotter aufnehmen, verladen, mit Fahrzeugen des AN transportieren und zur Beprobung zwischenlagern,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bearbeitrungsbreite </span>
               <TextComplement MarkLbl="61" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;&#x3e; 5,00 - 5,50&#x3c;&#x27;</span>
                </ComplBody>
                <ComplTail/>
