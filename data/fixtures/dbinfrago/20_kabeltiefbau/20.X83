            <DetailTxt>
             <Text>
              <p style="margin-left:-2pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Aptos Narrow;font-size:10pt;Color:rgb(0,0,0);">Gehrungsschnitte am Kabeltrog aus Betonfertigteilen</span>
               <br/>
               <span style="font-family:Aptos Narrow;font-size:10pt;Color:rgb(0,0,0);">als Trog mit aufliegenden oder innenliegenden Deckeln, Größe</span>
               <br/>
               <TextComplement MarkLbl="61" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Aptos Narrow;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e; III / I II i .F . / I IIa i .F . / I V / I V i .F . / V&#x3c;)&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Aptos Narrow;font-size:10pt;Color:rgb(0,0,0);"> herstellen. </span>
              </p>
              <p style="margin-left:-2pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Aptos Narrow;font-size:10pt;Color:rgb(0,0,0);">Abgerechnet wird je Richtungsänderung.</span>
              </p>
              <p style="margin-left:-70pt;text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="margin-left:-70pt;text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
