         <Item ID="AAAAAAABIMBKKMJA" RNoPart="5530">
          <Qty>0.000</Qty>
          <QU>St</QU>
          <Description ID="R20210929061924020000813">
           <WICNo>Muster-LV/20/01.20.5530. </WICNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Kernbohrung, senkrecht zur Untergrundfläche,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Untergrundfläche </span>
               <TextComplement MarkLbl="61" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;&#x3e; waagerecht / senkrecht&#x3c;&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">  , aus</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> </span>
               <TextComplement MarkLbl="62" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;&#x3e; Stahlbeton / Normalbeton&#x3c;&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> , Bohrdurchmesser über</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">100 bis 150 mm, Bohrtiefe über 2,5 bis 5 cm, einschl.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Lösen des Bohrkerns aus dem Gefüge, Arbeitshöhe bis 2 m, nicht wiederverwendbare Stoffe sind zu sammeln, auf</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Flächen des AN zu transportieren und bis zur weiteren</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Verwertung zwischenzulagern. Einführungsbausatz mit</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">wasserdichter Abdichtung für </span>
               <TextComplement MarkLbl="63" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;&#x3e; PVC / PE-HD / PP &#x3c;&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> - Rohre, einschließlich Abdeckung der Kabelgestelle und Verteilungen. </span>
               <br/>
              </p>
             </Text>
            </DetailTxt>
