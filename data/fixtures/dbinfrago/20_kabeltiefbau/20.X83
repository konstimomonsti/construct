          <QU>m</QU>
          <Description ID="R20210929061818003000132">
           <WICNo>Muster-LV/20/01.18.0240. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Anpassung von Plattenbelägen herstellen. Platten auf</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Passmaß zuarbeiten und an Kanten und Einfassungen bzw.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">an Aussparungen und Einbauten über 1 m² Einzelgröße</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">verlegen. Kanten wie Hausmauer, Zaunsockel, Borde,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Rinnen, Schachtabdeckung eckig. Betonplatten, Dicke 40</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">mm bis unter 80 mm. Platten schneiden. &#x22;</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Anpassung von Plattenbelägen herstellen  </span>
                <br/>
                <span>MLV-KTB_01180240</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
