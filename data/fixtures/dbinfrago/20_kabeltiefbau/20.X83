          <Description ID="R20250728074731716000001">
           <WICNo>Muster-LV/20/01.20.1061. </WICNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <p style="margin-left:-2pt;margin-right:2pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Aptos Narrow;font-size:10pt;Color:rgb(0,0,0);">Gehrungsschnitte am Kabeltrog der Größen </span>
               <TextComplement MarkLbl="61" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Aptos Narrow;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;I / II&#x3c;)&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Aptos Narrow;font-size:10pt;Color:rgb(0,0,0);">,  </span>
               <TextComplement MarkLbl="62" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Aptos Narrow;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;gemäß DBS 918065 / aus Betonfertigteilen / mit Betonfertigteildeckel, Unterteil gemäß Ausführungsunterlagen des AN / als Kunststoff-Leichtbaukabeltrog / als Kunststoff-Leichtbaukabeltrog mit Betonfertigteildeckel / gemäß Ausführungsunterlagen des AN&#x3c;)&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Aptos Narrow;font-size:10pt;Color:rgb(0,0,0);"> mit aufliegenden oder innenliegenden Deckeln herstellen. Abgerechnet wird je Richtungsänderung.</span>
              </p>
              <p style="margin-left:-70pt;text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="margin-left:-70pt;text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="margin-left:-70pt;text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
             </Text>
            </DetailTxt>
