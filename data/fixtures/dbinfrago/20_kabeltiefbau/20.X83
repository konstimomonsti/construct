         <Item ID="AAAAAAABILPJPGOA" RNoPart="1450">
          <Qty>0.000</Qty>
          <QU>St</QU>
          <Description ID="R20210929061842672000385">
           <WICNo>Muster-LV/20/01.20.1450. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
