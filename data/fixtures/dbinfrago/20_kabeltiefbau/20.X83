             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Baugrundgutachten im AUSNAHMEFALL  </span>
                <br/>
                <span>MLV-KTB_01010190</span>
               </p>
              </TextOutlTxt>
