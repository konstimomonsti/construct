         <Item ID="AAAAAAABIMBDNOLI" RNoPart="4760">
          <Qty>0.000</Qty>
          <QU>St</QU>
          <Description ID="R20210929061915613000728">
           <WICNo>Muster-LV/20/01.20.4760. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Einfassungsrahmen Größe XIVa aus</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Stahlbetonfertigteilen, Beton C 35/45 nach EN 206-1,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Ausführung als U-förmiger Rahmen mit oberer und</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">unterer Nut-/Falzverbindung liefern und einbauen Länge</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">1000 mm Breite 1000 mm Höhe 200 mm Einschließlich</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">aller notwendigen Erdarbeiten, überschüssiges Material</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">ist auf Flächen des AN zu transportieren, zur</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Beprobung abzulegen und bis zum Wiedereinbau bzw. der</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">weiteren Verwertung zwischenzulagern. &#x22;</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Einfassungsrahmen Größe XIVa  </span>
                <br/>
                <span>MLV-KTB_01204760</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
