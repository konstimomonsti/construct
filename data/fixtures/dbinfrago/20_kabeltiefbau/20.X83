            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Markierung mit Kabelmerksteinen Gr. </span>
               <TextComplement MarkLbl="61" Kind="Owner">
                <ComplCaption/>
