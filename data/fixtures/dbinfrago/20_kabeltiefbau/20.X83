      <BoQCtgy ID="AAAAAAABILNHENEI" RNoPart="09">
       <LblTx>
        <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
         <span>Gründungen</span>
        </p>
       </LblTx>
       <BoQBody>
        <Itemlist>
         <Item ID="AAAAAAABILNHFPLI" RNoPart="0010">
          <Qty>0.000</Qty>
          <QU>m3</QU>
          <Description ID="R20210929061812103000067">
           <WICNo>Muster-LV/20/01.09.0010. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Unbewehrten Beton herstellen. Beton als Füllbeton bzw.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">als Bodenersatz. Druckfestigkeitsklasse C8/10,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Expositionsklasse X0. Beton ohne Schalung herstellen. &#x22;</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Magerbeton als Füllbeton  </span>
                <br/>
                <span>MLV-KTB_01090010</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABILNHHDKI" RNoPart="0020">
          <Qty>0.000</Qty>
          <QU>m3</QU>
          <Description ID="R20210929061812191000068">
           <WICNo>Muster-LV/20/01.09.0020. </WICNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Ortbeton Fundament als Stahlbeton, Normalbeton  </span>
               <TextComplement MarkLbl="61" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;&#x3e;C XXX, XC2, XD2, WA&#x3c;&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> DIN EN 206-1, DIN 1045-2,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Ausführung gemäß Zeichnung Bauteil: Fundamente für</span>
               <br/>
               <TextComplement MarkLbl="62" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;&#x3e;Beschreibung&#x3c;&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> einschließlich Schalung: glatte</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Schalung nach Wahl des AN. Schalung vorhalten und</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">beseitigen. Sichtbare Betonkanten mit Dreikantleisten</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">brechen, Kehlen ausrunden. Einschließlich Herstellen</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">von Aussparungen, Nischen etc. Bewehrung wird</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">gesondert vergütet. &#x22;</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Ortbeton Fundament  </span>
                <br/>
                <span>MLV-KTB_01090020</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABILNHIIKA" RNoPart="0030">
          <Qty>0.000</Qty>
          <QU>t</QU>
          <Description ID="R20210929061812285000069">
           <WICNo>Muster-LV/20/01.09.0030. </WICNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bewehrung aus Betonstabstahl B500B DIN 488, alle</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Durchmesser, alle Längen, liefern und verlegen.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Ausführung gemäß Zeichnung. Bauteil(e): Fundamente für</span>
               <br/>
               <TextComplement MarkLbl="61" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;&#x3e;Beschreibung&#x3c;&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">. &#x27; &#x22;</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Betonstabstahl B500B alle Durchmesser  </span>
                <br/>
                <span>MLV-KTB_01090030</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
        </Itemlist>
       </BoQBody>
      </BoQCtgy>
      <BoQCtgy ID="AAAAAAABILNHJOII" RNoPart="16">
       <LblTx>
        <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
         <span>Oberbau</span>
        </p>
       </LblTx>
       <BoQBody>
        <Itemlist>
         <Item ID="AAAAAAABILNHLBAI" RNoPart="0009">
          <Qty>0.000</Qty>
          <QU>m</QU>
          <Description ID="R20210929061812381000071">
           <WICNo>Muster-LV/20/01.16.0009. </WICNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Schotterhalterung nach statischen und</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">konstruktiven Erfordernissen nach Ausführungsunterlagen des AN herstellen.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Art des Verbaus:</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">zugelassenes Verfahren nach Wahl des AN.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Schotterhalterung für Abgrabungstiefen bis 0,75 m</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">unter Schwellenoberkante. </span>
               <TextComplement MarkLbl="61" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;&#x3e;Einbau bündig mit Oberkante Randweg&#x3c;&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Schotterhalterung herstellen </span>
                <br/>
                <span>MLV-KTB_01160009</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABILNHMFNI" RNoPart="0010">
          <Qty>0.000</Qty>
          <QU>m</QU>
          <Description ID="R20210929061812469000072">
           <WICNo>Muster-LV/20/01.16.0010. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bauzeitlicher Verbau für Schotterhalterung (Gleis) nach statischen und konstruktiven Erfordernissen herstellen, vorhalten, ggf. an Bauzustände anpassen, als Baubehelf vorhalten und beseitigen. Ggf. erforderliches mehrmaliges</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Umsetzen ist mit einzurechnen. Art des Verbaus:</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">zugelassenes Verfahren nach Wahl des AN.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Schotterhalterung für Abgrabungstiefen bis 0,75 m</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">unter Schwellenoberkante.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Bauzeitlicher Verbau für Schotterhalterung (Gleis)  </span>
                <br/>
                <span>MLV-KTB_01160010</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABILNHNKAI" RNoPart="0011">
          <Qty>0.000</Qty>
          <QU>m</QU>
          <Description ID="R20210929061812559000073">
           <WICNo>Muster-LV/20/01.16.0011. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bauzeitlicher Verbau für Schotterhalterung (Weichen) nach statischen</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">und konstruktiven Erfordernissen herstellen,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">vorhalten, ggf. an Bauzustände anpassen, als</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Baubehelf vorhalten und beseitigen. Ggf.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">erforderliches mehrmaliges Umsetzen ist mit</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">einzurechnen. Art des Verbaues: zugelassenes Verfahren</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">nach Wahl des AN . Schotterhalterung für</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Abgrabungstiefen bis 0,75 m unter Schwellenoberkante .</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Bauzeitlicher Verbau für Schotterhaltung (Weichen)  </span>
                <br/>
                <span>MLV-KTB_01160011</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABILNHOOFA" RNoPart="0020">
          <Qty>0.000</Qty>
          <QU>m</QU>
          <Description ID="R20210929061812654000074">
           <WICNo>Muster-LV/20/01.16.0020. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Verbau zur Absicherung von Abgrabungen /</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Geländesprüngen nach statischen und konstruktiven</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Erfordernissen im Gleisbereich herstellen, vorhalten,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">ggfs. an Bauzustände anpassen, als Baubehelf vorhalten</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">und beseitigen. Ggfs. erforderliches mehrmaliges</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Umsetzen ist mit einzurechnen. Art des Verbaues:</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">zugelassenes Verfahren nach Wahl des AN. Absicherung</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">für Abgrabungstiefen bis 1,25 m unter</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Schwellenoberkante. &#x22;</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>konstruktive Absicherung Geländesprung  </span>
                <br/>
                <span>MLV-KTB_01160020</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABILOEADFA" RNoPart="0030">
          <Qty>0.000</Qty>
          <QU>m</QU>
          <Description ID="R20210929061812744000075">
           <WICNo>Muster-LV/20/01.16.0030. </WICNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bettung verkleben, manuell, Schotterschulter</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">waagerecht und geneigte Fläche, Auftragsbreite über</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">0,50 bis </span>
               <TextComplement MarkLbl="61" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;&#x3e;1,00&#x3c;&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> m, mit 2-Komponenten-Epoxydharz</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">mit EBA-Zulassung. Abgerechnet wird je lfm gesicherter</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Schotterflanke. &#x22;</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Schotterverklebung  </span>
                <br/>
                <span>MLV-KTB_01160030</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABILOEBHJI" RNoPart="0040">
          <Qty>0.000</Qty>
          <QU>m</QU>
          <Description ID="R20210929061812834000076">
           <WICNo>Muster-LV/20/01.16.0040. </WICNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Vorhandene Schiene aufnehmen, zum Lagerplatz des AN</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">transportieren und </span>
               <TextComplement MarkLbl="61" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;&#x3e; zerlegen und sortieren, Schienen zum Verschrotten trennen, ggf. notwendige zusätzliche Brennschnitte sind einzurechnen. / zum Wiedereinbau</span>
                 <br/>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">zwischenlagern&#x3c;&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> , Hebegerät und Transportmittel</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">stellt der AN.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Schiene zurückbauen  </span>
                <br/>
                <span>MLV-KTB_01160040</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABILOECLNI" RNoPart="0050">
          <Qty>0.000</Qty>
          <QU>St</QU>
          <Description ID="R20210929061812926000077">
           <WICNo>Muster-LV/20/01.16.0050. </WICNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Holzschwellen </span>
               <TextComplement MarkLbl="61" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;&#x3e;KS 54&#x3c;&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> einschließlich Kleineisen</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">und Zwischenlagen aufnehmen, transportieren zum</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Zwischenlagerplatz des AN und lagern. Hebegerät und</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Transportmittel stellt der AN. Entsorgung erfolgt über</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">den AG. &#x22;</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
