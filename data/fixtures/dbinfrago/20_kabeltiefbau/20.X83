          <Qty>0.000</Qty>
          <QU>St</QU>
          <Description ID="R20210929061842579000384">
           <WICNo>Muster-LV/20/01.20.1440. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
