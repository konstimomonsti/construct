          <QU>m</QU>
          <Description ID="R20210929061813107000079">
           <WICNo>Muster-LV/20/01.16.0070. </WICNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Schotter auf dem Bahnkörper bei ausgebautem Gleis</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">aufnehmen, verladen, mit Fahrzeugen des AN</span>
