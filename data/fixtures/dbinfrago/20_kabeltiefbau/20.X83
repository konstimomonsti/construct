         <Item ID="AAAAAAABIMAGFGIA" RNoPart="3040">
          <Qty>0.000</Qty>
          <QU>St</QU>
          <Description ID="R20210929061857874000545">
           <WICNo>Muster-LV/20/01.20.3040. </WICNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Kabelaufbauschacht Gr. IV ( IVa) aus Stahlbetonfertigteilen, LM1 nach DIN EN 1991-2.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bemessung für SW/ 2 nach Ril 804, EBA - Typzulassung oder</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">DB - Freigabe liefern und einbauen, Fugen mit Zementmörtel nach DIN 1045-2, Abschn. 5.3.8 herstellen, </span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">lichte Länge 900 mm, lichte Breite 800 mm, lichte Tiefe</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">800 mm. </span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Kabelaufbauschacht Gr. IV bestehend aus: </span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">- 1 Stück  Bodenelement mit Sickerloch </span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">- 2 Stück Einführungsrahmen mit vier Sollbruchstellen, h = 400 mm </span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">- 1 Stück Deckenplatte mit Einstiegsöffnung 70/70 cm </span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">- 1 Stück Deckelrahmen </span>
               <TextComplement MarkLbl="61" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;&#x3e; Klasse A / B / D &#x3c;&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
