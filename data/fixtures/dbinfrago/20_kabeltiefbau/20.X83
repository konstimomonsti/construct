         <Item ID="AAAAAAABIMALLKPA" RNoPart="3811">
          <Qty>0.000</Qty>
          <QU>St</QU>
          <Description ID="R20210929061905710000627">
           <WICNo>Muster-LV/20/01.20.3811. </WICNo>
           <CompleteText>
