       <BoQBody>
        <Itemlist>
         <Remark ID="AAAAAAABILNDKJMA">
          <Description ID="R20210929061946469001058">
           <WICNo>Muster-LV/20/01.24.</WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Verbindungselemente</span>
              </p>
             </Text>
