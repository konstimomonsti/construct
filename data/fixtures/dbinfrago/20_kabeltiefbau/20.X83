         <Item ID="AAAAAAABIMCANJCI" RNoPart="0440">
          <Qty>0.000</Qty>
          <QU>St</QU>
          <Description ID="R20210929061932592000905">
           <WICNo>Muster-LV/20/01.22.0440. </WICNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Kabel kennzeichnen gemäß Vorschrift (DV 881 Th. 1)</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Kabelkennzeichnungsband mit Prägung für alle zu verlegenden</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Kabel liefern und im Abstand von  </span>
               <TextComplement MarkLbl="61" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;&#x3e; 5 m im Bahnhofsbereich / 50 m auf freier Strecke&#x3c;&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">  am Kabel anbringen. Kabelkennzeichnungsbänder mit Kabelnummer und Aufbau bedrucken. Es sind die einschlägigen Vorschriften bezüglich der Farbe zu beachten. Bei Schächten zusätzlich vor, hinter und im Schacht kennzeichnen, bei Muffen vor und hinter dem Bausatz, als auch vor und nach der Muffe kennzeichnen. </span>
               <br/>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Kabelkennzeichnungsbänder anbringen  </span>
                <br/>
                <span>MLV-KTB_01220440</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIMCAONOI" RNoPart="0450">
          <Qty>0.000</Qty>
          <QU>St</QU>
          <Description ID="R20210929061932685000906">
           <WICNo>Muster-LV/20/01.22.0450. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Kabelhalterungen für Bestandsschacht liefern und</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">einbauen Liefern und montieren der Kabelhalterungen,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">einschließlich Kabelschacht aufdecken, Kabel (bis 10</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Stück) kennzeichnen, umverlegen, bündeln und an</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Kabelhalterungen befestigen, Kabelschacht zudecken,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">einschließlich Abdichten zulaufender Leerrohre mit</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Rohrdeckel/zugelassenen Dichtmassen. Abgerechnet wird</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">die tatsächlich erforderliche Stückzahl</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Kabelhalterungen.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Kabelhalterungen für Bestandsschacht liefern und einbauen</span>
                <br/>
                <span>MLV-KTB_01220450</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
