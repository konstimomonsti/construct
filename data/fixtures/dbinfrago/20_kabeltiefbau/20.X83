          <Qty>0.000</Qty>
          <QU>St</QU>
          <Description ID="R20210929061847599000437">
           <WICNo>Muster-LV/20/01.20.1970. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Zulage zu Position &#x22;Abzweigkasten 86&#x22; für</span>
               <br/>
