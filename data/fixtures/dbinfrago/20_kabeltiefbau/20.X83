               </TextComplement>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">  wasserdicht</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">einbetonierten PVC-Muffen </span>
               <TextComplement MarkLbl="62" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;&#x3e;DN XXX&#x3c;&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> , h =  </span>
               <TextComplement MarkLbl="63" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;&#x3e;XXX&#x3c;&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;mm. &#x22;</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>PVC-Muffen  </span>
                <br/>
                <span>MLV-KTB_01201990</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
