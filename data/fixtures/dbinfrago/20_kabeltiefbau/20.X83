                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> qm, Bündel</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">aus mehreren Kabeln werden als ein Stück abgerechnet. &#x22;</span>
              </p>
             </Text>
            </DetailTxt>
