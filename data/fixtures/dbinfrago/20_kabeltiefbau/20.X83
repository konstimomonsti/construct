           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Spleiß-Patch-Baugruppe Kombimodul mit Serienfreigabe</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">der DB-Netz, für 24 Fasern im EMS/ SC-Management, zum</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Einbau in ODF Gestell (HVT), zum Spleißen von Kabel</span>
               <br/>
