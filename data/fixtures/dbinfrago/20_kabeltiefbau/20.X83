         <Item ID="AAAAAAABIMBGDKBA" RNoPart="5030">
          <Qty>0.000</Qty>
          <QU>St</QU>
          <Description ID="R20210929061918542000758">
           <WICNo>Muster-LV/20/01.20.5030. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Mech.Schrankengestell (GR 2) des AG setzen, zwischen</span>
               <br/>
