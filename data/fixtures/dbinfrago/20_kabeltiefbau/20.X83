          <Description ID="R20210929061949134001087">
           <WICNo>Muster-LV/20/01.24.0210. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Wandhalterung für Muffen mit Serienfreigabe der</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">DB-Netz, entsprechend dem Muffen Hersteller,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">einschließlich Wandmontagekit und Zubehör, liefern</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">und an Wände bzw. in Kabelschächten und Doppelböden</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">montieren. Bei Ersatzbeschaffung oder Erweiterung sind</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">die Produkte des bereits im Einsatz befindlichen</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Herstellers zu verwenden, Abweichung nur in Abstimmung</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">mit dem Anlagenverantwortlichen.</span>
              </p>
             </Text>
            </DetailTxt>
