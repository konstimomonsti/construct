         <Item ID="AAAAAAABIMBPHEAA" RNoPart="0130">
          <Qty>0.000</Qty>
          <QU>m</QU>
          <Description ID="R20210929061929763000874">
           <WICNo>Muster-LV/20/01.22.0130. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Vom AG beigestelltes Kabel Durchmesser bis 25 mm außer</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Betrieb, an Schiene LWL-Schienenfußkabel (SFK) gemäß</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Verlegerichtlinie verlegen, an der Schiene mit</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Fußklammer befestigen. Einschl. Schiene vor der</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Verlegung des Kabels von sämtlichen Verunreinigungen</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">säubern, insbesondere alle Schottersteine entfernen.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Durch DB AG zugelassene Schienenfußklammern für SFK</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">liefern und in jedem zweiten Schwellenfach anordnen,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">einschließlich Logistik und Transport Kabeltrommel</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Übergabestelle/Einbaustelle, abgerechnet wird das</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">verlegte Kabel an der Schiene. &#x22;</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>LWL-Schienenfußkabel (SFK), D bis 25 mm  </span>
                <br/>
                <span>MLV-KTB_01220130</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
