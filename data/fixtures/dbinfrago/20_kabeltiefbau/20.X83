         <Item ID="AAAAAAABILNPAGFI" RNoPart="0010">
          <Qty>0.000</Qty>
          <QU>St</QU>
          <Description ID="R20210929061954890001150">
           <WICNo>Muster-LV/20/01.25.0010. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Kabel der Außenanlage nach DV 881 prüfen -</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Isolationswiderstand in (Ader/Erde, Ader/Ader),</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Einzeladerwiderstand in Ohm - Die Prüfung muss vor der</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Beschaltung der Kabelschränke, -verteiler</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">(Rangierungen sind nur auf einer Seite aufzulegen) und</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Endverbraucher erfolgen Kabelmessung. &#x22;</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Signalkabel prüfen  MLV-KTB_01250010</span>
