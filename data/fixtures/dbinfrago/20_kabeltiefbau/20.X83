         <Item ID="AAAAAAABIMBOLCJI" RNoPart="0290">
          <Qty>0.000</Qty>
          <QU>m</QU>
          <Description ID="R20210929061931235000890">
           <WICNo>Muster-LV/20/01.22.0290. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Schienenfußabzweig (SFA) inkl. Kabelschutzschlauch</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">(ganz oder geteilt) und Befestigungsset, mit</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">DB-Freigabe liefern und gemäß Montageanleitung</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">einbauen. Der SFA-Typ und das Befestigungsset wird</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">entsprechend der Schwellenlänge und -typ, sowie dem</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Schienenfußkabeltyp vom AG vorgegeben. &#x22;</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Schienenfußabzweig (SFA)  </span>
                <br/>
                <span>MLV-KTB_01220290</span>
               </p>
