         <Item ID="AAAAAAABILOHAPNI" RNoPart="0160">
          <Qty>0.000</Qty>
          <QU>m</QU>
          <Description ID="R20210929061823206000187">
           <WICNo>Muster-LV/20/01.19.0160. </WICNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Unterkreuzung von Gleisen mit Stahlrohr DN 200. Stahlrohr gem. DIN 4835, Wandstärke nach statischen Erfordernissen inklusiv Abrostungszuschlag. Überdeckung</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Schwellenoberkante - Rohrscheitel über </span>
               <TextComplement MarkLbl="61" Kind="Owner">
                <ComplCaption/>
