               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">liefern, bei ausgebautem Gleis profilgerecht einbauen,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">ebnen und verdichten. Einbaubreite über </span>
               <TextComplement MarkLbl="62" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;&#x3e;5,00 bis 5,50&#x3c;&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> m, Schichtdicke </span>
