               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Größe 2 für zusätzliche Stützen, Länge </span>
               <TextComplement MarkLbl="61" Kind="Owner">
                <ComplCaption/>
