         <Item ID="AAAAAAABIMBGIGLI" RNoPart="5060">
          <Qty>0.000</Qty>
          <QU>St</QU>
          <Description ID="R20210929061918930000762">
           <WICNo>Muster-LV/20/01.20.5060. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Kunststoffsockel des AG, Anbaumaße DIN 43629-2, für</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Kabelverteilerschrank, glasfaserverstärkt, zur</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Einbaustelle transportieren, komplett montieren und</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;neben Kabelschacht/Trog im Gleisbereich / im</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Erdreich / in Böschungs- bzw. Hanglage&#x3c;)&#x27; einbauen,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">einschl. Anschluss mit bis zu 2 Kabelschutzrohren</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">DN/OD 110 an Kabelschacht/Trog, einschl.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Kabelschacht/Trog ausschneiden und Kabelschutzrohre</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">einputzen. Höhe Außenmaß: 900mm einschließlich aller</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">notwendigen Erdarbeiten, überschüssiges Material ist</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">auf Flächen des AN zu transportieren, zur Beprobung</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">abzulegen und bis zum Wiedereinbau bzw. der weiteren</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Verwertung zwischenzulagern. Vom AG an der</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Übergabestelle beigestelltes Material laden,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">zwischentransportieren, abladen und fachgerecht</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">einbauen. &#x22;</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Kunststoffsockel des AG für Kabelverteilerschrank  </span>
                <br/>
                <span>MLV-KTB_01205060</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
