         <Item ID="AAAAAAABIMAFECIA" RNoPart="2910">
          <Qty>0.000</Qty>
          <QU>St</QU>
          <Description ID="R20210929061856558000531">
           <WICNo>Muster-LV/20/01.20.2910. </WICNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Kabelaufbauschacht Gr. III aus Stahlbetonfertigteilen,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">LM1 nach DIN EN 1991-2. Bemessung für SW/2 nach </span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Ril 804, EBA-Typzulassung oder DB-Freigabe liefern und</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">einbauen, Fugen mit Zementmörtel nach DIN 1045-2,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Abschn. 5.3.8 herstellen, lichte Länge 1170 mm, lichte</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Breite 650 mm, lichte Tiefe 800 mm.</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Kabelaufbauschacht Gr. III bestehend aus: </span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">- 1 Stück Bodenelement mit Sickerloch </span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">- 1 Stück Einführungsrahmen mit vier Sollbruchstellen, h = 400 mm </span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">- 1 Stück Zwischenrahmen, h = 400 mm </span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">- 1 Stück Deckelrahmen </span>
               <TextComplement MarkLbl="61" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;&#x3e;Klasse A/B / D&#x3c;&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">  </span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">- 2 Stück Deckel Klasse </span>
               <TextComplement MarkLbl="62" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;&#x3e;A / B/ D&#x3c;&#x27;</span>
                </ComplBody>
