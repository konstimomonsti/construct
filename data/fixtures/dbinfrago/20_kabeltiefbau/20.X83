             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Wanddurchbruch Beton bohren  </span>
                <br/>
                <span>MLV-KTB_01205570</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIMBLBDBA" RNoPart="5580">
          <Qty>0.000</Qty>
          <QU>St</QU>
          <Description ID="R20210929061924505000818">
           <WICNo>Muster-LV/20/01.20.5580. </WICNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Deckendurchbruch in Stahlbeton, Dicke </span>
               <TextComplement MarkLbl="61" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;&#x3e; über 20 bis 25  / über 25 bis 36 &#x3c;&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> cm, bohren, für Medienrohr</span>
               <br/>
               <TextComplement MarkLbl="62" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;&#x3e;DN 200 / DN 300&#x3c;&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> , nicht wiederverwendbare Stoffe</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">sind zu sammeln, auf Flächen des AN zu transportieren</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">und bis zur weiteren Verwertung zwischenzulagern. &#x22;</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Deckendurchbruch Stahlbeton bohren  </span>
                <br/>
                <span>MLV-KTB_01205580</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIMBLCHIA" RNoPart="5590">
          <Qty>0.000</Qty>
          <QU>St</QU>
          <Description ID="R20210929061924603000819">
           <WICNo>Muster-LV/20/01.20.5590. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Gebäudeeinführung aus Kabelschutzrohren wasserdicht, 2</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Rohre nebeneinander, je DN/OD 110, bauseits verlegt,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">in vorhanden Durchbruch einsetzen, für Wanddicke über</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">20 bis 25 cm, Einführung fachgerecht einputzen,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">einschließlich aller Nebenarbeiten.  &#x22;</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>wasserdichte Gebäudeeinführung  </span>
                <br/>
                <span>MLV-KTB_01205590</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIMBLDLHA" RNoPart="5591">
          <Qty>0.000</Qty>
          <QU>St</QU>
          <Description ID="R20210929061924700000820">
           <WICNo>Muster-LV/20/01.20.5591. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Fachgerechtes Öffnen und Schließen einer vorhandenen</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">wasserdichten Gebäudeeinführung zur Kabeleinführung.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Dichtsystem entfernen und nach der Schutzrohreinführung </span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">wieder wasserdicht herstellen inkl. aller Zusammenhangsarbeiten.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>bestehende wasserdichte Gebäudeeinführung öffnen u. schließen  </span>
                <br/>
                <span>MLV-KTB_01205591</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIMBLEPCI" RNoPart="5592">
          <Qty>0.000</Qty>
          <QU>St</QU>
          <Description ID="R20210929061924797000821">
           <WICNo>Muster-LV/20/01.20.5592. </WICNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Herstellen und Liefern von Kabel- u. Rohrschottungen</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">in </span>
               <TextComplement MarkLbl="61" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;&#x3e;Massivwand/ Stahlbetonwand/Stahlbetondecke/ Trockenbauwand&#x3c;&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> der Feuerwiderstandsklasse EI </span>
               <TextComplement MarkLbl="62" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;&#x3e;90&#x3c;&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">nach DIN EN 13501 (ehemals S90/ R90 nach DIN 4102) mit</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">weichem und flexiblen Schaumstoffformteilen sowie Füllmassen, Brandschutzfunktion durch Intumeszens,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">inkl. Verfüllen der Zwickel und Zwischenräume, aller</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Nebenarbeiten und Hilfskonstruktionen einseitige Kennzeichnung mittels Kennzeichnungsschild mit Angabe einbauende Firma, Hersteller, Produkt, Brandschutzleistung und Datum. Abmessung der Schottung </span>
               <TextComplement MarkLbl="63" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;&#x3e; bis 0,25 m² / 0,25 -1,00 m²&#x3c;&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">, Wand- bzw. Deckendicke: </span>
               <TextComplement MarkLbl="64" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;&#x3e;36,5 cm&#x3c;&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Brandschottung für Kabel- u. Schutzrohre herstellen </span>
                <br/>
                <span>MLV-KTB_01205592</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIMBLGEKI" RNoPart="5593">
          <Qty>0.000</Qty>
          <QU>St</QU>
          <Description ID="R20210929061924893000822">
           <WICNo>Muster-LV/20/01.20.5593. </WICNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Vorhandene Kabelbrandschutzdurchführung durch </span>
               <TextComplement MarkLbl="61" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;&#x3e;Massivwand/ Stahlbetonwand/Stahlbetondecke/ Trockenbauwand&#x3c;&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> öffnen, nach Kabelnachbelegung Brandschottung mit intumeszierender Brandschutzmasse als permanente Brandabschottung für Einzelkabel oder Kabelbündel herstellen. Liefern und montieren inkl. aller Zusammenhangsarbeiten.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Wand- bzw. Deckendicke: </span>
               <TextComplement MarkLbl="62" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;&#x3e;36,5 cm&#x3c;&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> .</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>bestehende Kabelbrandschutzdurchführung in Gebäuden nachbelegen  </span>
                <br/>
                <span>MLV-KTB_01205593</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIMBLHJDA" RNoPart="5594">
          <Qty>0.000</Qty>
          <QU>m2</QU>
          <Description ID="R20210929061924989000823">
           <WICNo>Muster-LV/20/01.20.5594. </WICNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Brandschutzkabelbandage mit DB Netz Freigabe für TK -</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">und LST- Anwendungen, geeignet zur Verkleidung von</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">leichtentflammbaren Außenkabeln </span>
               <TextComplement MarkLbl="61" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;&#x3e;innerhalb/ außerhalb&#x3c;&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> von Gebäuden, Verkleidung von einzelnen Kabeln, Kabelbündeln,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Kabelpritschen und Steigtrassen, Montage gemäß</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Herstellervorgaben, inklusive alle benötigten</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Zubehörteile, Befestigungen, Kleinteile und weitere</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">für die fachgerechte Montage erforderliche</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Komponenten, inklusive dauerhafte Kennzeichnung mit</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Nennung des Produktes, des Errichters, des</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Montagedatums und der relevanten bauaufsichtlichen</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Zulassung. Abrechnung gemäß Oberfläche</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Kabelbandage, inklusive gemäß Montageanleitung</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">erforderlicher Überlappungen. Lieferung und Montage</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">an bestehenden Kabeln und Trassen.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Brandschutzkabelbandage herstellen </span>
                <br/>
                <span>MLV-KTB_01205594</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
