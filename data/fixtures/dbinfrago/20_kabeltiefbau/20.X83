          <Description ID="R20210929061931142000889">
           <WICNo>Muster-LV/20/01.22.0280. </WICNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Schienenfußkabel zur Wiederverwendung ausbauen und auf</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Kabeltrommeln des AN aufrollen, einschl. Ausbau der</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Klammern. Alle Materialien sind zur</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bereitstellungsfläche des AN zu transportieren,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">abzuladen und zu lagern. </span>
               <TextComplement MarkLbl="61" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;&#x3e;Material erneut aufnehmen, zur Einbaustelle transportieren und wieder montieren einschl. aller Nebenarbeiten.&#x3c;&#x27;</span>
                </ComplBody>
                <ComplTail/>
