         <Item ID="AAAAAAABILOCGFJI" RNoPart="0220">
          <Qty>0.000</Qty>
          <QU>m2</QU>
          <Description ID="R20210929061817813000130">
           <WICNo>Muster-LV/20/01.18.0220. </WICNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Plattenbelag aus Betonplatten auf vorhandener</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Tragschicht in Rad- und Gehwegen herstellen.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bettungsdicke 3 bis 5 cm, Plattengröße mm/mm/mm</span>
               <br/>
               <TextComplement MarkLbl="61" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;&#x3e;300/300/40&#x3c;&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> . &#x27; Die Formteile auf Grund des</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Verbands bzw. nach Unterlagen des AG gehören zum</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Leistungsumfang. Das Trennen von Platten wird</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">gesondert vergütet. Platten mit Vorsatzschicht, Kanten</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">gefast, auf Plattenbett aus Baustoffgemisch 0/5,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">verfugen mit Gesteinskörnung 0/2. &#x22;</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Plattenbelag aus Betonplatten herstellen  </span>
                <br/>
                <span>MLV-KTB_01180220</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
