     <LblTx>
      <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
       <span>Sicherung geg. Gefahren aus dem</span>
       <br/>
       <span>Bahnbetrieb u. bauaffine Leistungen</span>
      </p>
     </LblTx>
     <BoQBody>
      <BoQCtgy ID="AAAAAAABILFPBAAA" RNoPart="01">
       <LblTx>
        <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
         <span>Sicherungsmaßnahmen</span>
        </p>
       </LblTx>
       <BoQBody>
        <Itemlist>
         <Item ID="AAAAAAABILFPBIDA" RNoPart="0010">
          <LumpSumItem>Yes</LumpSumItem>
          <Qty>1.000</Qty>
          <QU>psch</QU>
          <CtlgAssign>
           <CtlgID>AAAAAAABIIJNAANA</CtlgID>
           <CtlgCode>000</CtlgCode>
          </CtlgAssign>
          <Description>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Planung und Durchführung der vorgegebenen</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Sicherungsmaßnahmen zur Abwendung der Gefahren</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">aus dem Bahnbetrieb bei Arbeiten im Gleisbereich.</span>
               <br/>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Umfang der Sicherungsmaßnahmen:</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">alle während der zeitlichen Vorgaben für die Durchführung der Vorarbeiten betroffenen Gleisbereiche.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Sicherungsmaßnahmen Vorarbeiten</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
           </CompleteText>
          </Description>
