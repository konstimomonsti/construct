          <QU>h</QU>
          <Description ID="R20190401115143428000170">
           <WICNo>DB Netz/100/01.20.0060. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Vorbeschriebene Wasserhaltungsanlage überwachen und</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">betreiben. Abgerechnet werden nur die vom AG bestätigten Betriebsstunden.</span>
              </p>
