                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;XXX&#x3c;)&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> </span>
               <span style="font-family:Helvetica;font-size:10pt;Color:rgb(0,0,0);">einschließlich Bewehrung</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Helvetica;font-size:10pt;Color:rgb(0,0,0);">Bewehrungsmaterial = </span>
