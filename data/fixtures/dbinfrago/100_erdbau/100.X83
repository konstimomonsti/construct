               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Inkl. Nachweis der Verbesserung durch vergleichende </span>
               <TextComplement MarkLbl="68" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;Rammsondierungen mit der schweren Rammsonde / Drucksondierungen&#x3c;)&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> vor und nach Einbau der Säulen. Anzahl der Sondierungen </span>
               <TextComplement MarkLbl="69" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;XXX&#x3c;)&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">. Unterlagen 1 x digital und </span>
               <TextComplement MarkLbl="70" Kind="Owner">
