            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIEOJNJKI" RNoPart="0230">
          <Qty>1.000</Qty>
          <QU>m</QU>
          <Description ID="R20190401115143588000238">
           <WICNo>DB Netz/100/01.21.0230. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bohrpfähle säubern, Bohrpfähle von anhaftendem Erdreich säubern, bestehend aus folgenden Teilleistungen </span>
              </p>
