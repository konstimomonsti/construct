           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Ortbetonverdrängungspfähle entsprechend statischer und konstruktiver Erfordernisse inkl. aller Systembauteile liefern und herstellen.</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Abgerechnet wird von der Unterkante, der bis zur Absetztiefe eingefahrenen Verrohrung bis OK Pfahl.</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bewehrung wird gesondert vergütet.</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
