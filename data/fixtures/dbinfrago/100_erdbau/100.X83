         <Item ID="AAAAAAABIEONCMMI" RNoPart="0440">
          <Qty>1.000</Qty>
          <QU>m3</QU>
          <Description ID="R20190401115143609000259">
           <WICNo>DB Netz/100/01.21.0440. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Verfüllen des Leerschlitzes Differenzschlitzwand bis zum Herstellniveau. Verfüllung mit kiesigem Material des AN, Material liefern, einbauen und verdichten. Abgerechnet wird von</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">planmäßiger Oberkante Schlitzwand bis zur Oberkante Leitwand in Länge der Schlitzwandachse multipliziert mit der Schlitzwandnenndicke.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Verfüllung Leerschlitz MLV-ERD_01210440</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
