           <WICNo>DB Netz/100/01.11.0182. </WICNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Boden für temporäre Überschüttung </span>
               <TextComplement MarkLbl="61" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;durchlässig / schwach durchlässig / nach Wahl des AN&#x3c;)&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> liefern, profilgerecht und lagenweise einbauen nach Plänen des AG, verdichten. Verdichtungsgrad DPr </span>
               <TextComplement MarkLbl="62" Kind="Owner">
