                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;monatlich / wöchentlich / täglich&#x3c;)&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">, Ergebnisse </span>
               <TextComplement MarkLbl="68" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
