           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Baustoffgemisch für Schutz- bzw. Tragschichten gemäß Zeichnung einschließlich erforderlicher Nachweise liefern, profilgerecht und eben einbauen sowie verdichten: Baustoffgemisch: </span>
               <TextComplement MarkLbl="61" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;schwach, wasserdurchlässiges KG 1 gemäß DBS 918062 / wasserdurchlässiges KG 2 gemäß DBS 918062 / sonstiges Baustoffgemisch gemäß Ril 836.4101&#x3c;)&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">. </span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Dicke: </span>
               <TextComplement MarkLbl="62" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;15, 20, 25, 30, 35, 40, 45, 50, 55, 60 cm&#x3c;)&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">, Einbau in </span>
               <TextComplement MarkLbl="63" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;1, 2, 3 Lagen&#x3c;)&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">, Verdichtungsgrad DPr ≥ </span>
               <TextComplement MarkLbl="64" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(97% / 100%&#x3c;)&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">. Abweichung Einbaudicke gemäß Ril 836.4104. Die Verdichtung ist in der Eigenüberwachung nachzuweisen. Dabei  ist gemäß &#x22;Prüfkatalog für Eigenüberwachungs- und Kontrollprüfungen&#x22; des AG vorzugehen.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Schutz- bzw. Tragschichten herstellen MLV-ERD_01150010</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIEJJJBEI" RNoPart="0020">
          <Qty>1.000</Qty>
          <QU>m2</QU>
          <Description ID="R20190401115143282000126">
           <WICNo>DB Netz/100/01.15.0020. </WICNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Oberfläche der Tragschicht OFTS für Oberbau herstellen: Ev2 mind. </span>
               <TextComplement MarkLbl="63" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;40, 50, 80, 100, 120&#x3c; MN/m2&#x3c;)&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> oder Evd mind. </span>
               <TextComplement MarkLbl="64" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;30, 35, 40, 45, 50&#x3c; MN/m2&#x3c;)&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">. Abweichung Sollhöhe, Unebenheit und Querneigung gemäß Ril 836.4104 und ZTV SoB-StB Auf der OFTS dürfen keine Spurrillen verbleiben. Fertig gestellte Oberflächen dürfen nicht mehr befahren werden.  Die Verdichtung ist in der Eigenüberwachung nachzuweisen.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Dabei ist gemäß &#x22;Prüfkatalog für Eigenüberwachungs- und</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Kontrollprüfungen&#x22; des AG vorzugehen.</span>
