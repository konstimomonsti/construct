               <span style="font-family:Helvetica;font-size:10pt;Color:rgb(0,0,0);">Pfahllänge ca. </span>
               <TextComplement MarkLbl="63" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;XXX&#x3c;)&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Helvetica;font-size:10pt;Color:rgb(0,0,0);"> m bis </span>
