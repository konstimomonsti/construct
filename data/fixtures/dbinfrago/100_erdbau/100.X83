          <Qty>1.000</Qty>
          <QU>m2</QU>
          <Description ID="R20190401115143190000025">
           <WICNo>DB Netz/100/01.09.0040. </WICNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Herstellen und Verdichten der Baugrubensohle mit</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">vorgegebener Querneigung und einer Ebenheit von </span>
               <TextComplement MarkLbl="65" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;XXX&#x3c;)&#x27;</span>
