         <Item ID="AAAAAAABIENDPAKI" RNoPart="0270">
          <Qty>1.000</Qty>
          <QU>m</QU>
          <Description ID="R20190401115143229000090">
           <WICNo>DB Netz/100/01.13.0270. </WICNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bahngraben inklusive Befestigung mit Sohlschalen </span>
               <TextComplement MarkLbl="63" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
