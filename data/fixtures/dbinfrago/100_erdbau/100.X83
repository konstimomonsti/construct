          <LumpSumItem>Yes</LumpSumItem>
          <Qty>1.000</Qty>
          <QU>psch</QU>
          <Description ID="R20190401115143415000169">
           <WICNo>DB Netz/100/01.20.0050. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Vorbeschriebene Wasserhaltungsanlage betriebsbereit  vorhalten.</span>
              </p>
