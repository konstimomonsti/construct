         <Item ID="AAAAAAABIEOGOLCI" RNoPart="0405">
          <Qty>1.000</Qty>
          <QU>m</QU>
          <Description ID="R20210311133227536000035">
           <WICNo>DB Netz/100/01.18.0405. </WICNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Helvetica;font-size:10pt;Color:rgb(0,0,0);">Ortbetonbohrpfähle entsprechend statischer und konstruktiver Erfordernisse in</span>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">kl. aller Systembauteile liefern und herstellen.</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Helvetica;font-size:10pt;Color:rgb(0,0,0);">Herrichten des Pfahlkopfes sowie die Durchführung von Probe- belastungen werden gesondert vergütet.</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Helvetica;font-size:10pt;Color:rgb(0,0,0);">Herstellen eines Pfahlfußes und Einbau eines Hülsenrohres ist im Bedarfsfall mit einzukalkulieren.</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Helvetica;font-size:10pt;Color:rgb(0,0,0);">Pfahl-Durchmesser: </span>
               <TextComplement MarkLbl="61" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;XXX&#x3c;)&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Helvetica;font-size:10pt;Color:rgb(0,0,0);"> m bis </span>
               <TextComplement MarkLbl="62" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;XXX&#x3c;)&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Helvetica;font-size:10pt;Color:rgb(0,0,0);"> m Pfahllänge </span>
               <TextComplement MarkLbl="63" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;XXX m&#x3c;)&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Helvetica;font-size:10pt;Color:rgb(0,0,0);"> </span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Helvetica;font-size:10pt;Color:rgb(0,0,0);">Neigung </span>
               <TextComplement MarkLbl="64" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;lotrecht / geneigt bis 1:..&#x3c;)&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> </span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Helvetica;font-size:10pt;Color:rgb(0,0,0);">Material: </span>
               <TextComplement MarkLbl="65" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;XXX&#x3c;)&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> </span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Helvetica;font-size:10pt;Color:rgb(0,0,0);">Druckfestigkeitsklasse: </span>
               <TextComplement MarkLbl="66" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;XXX&#x3c;)&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> </span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Helvetica;font-size:10pt;Color:rgb(0,0,0);">Expositionsklasse: </span>
               <TextComplement MarkLbl="67" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;XXX&#x3c;)&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> </span>
