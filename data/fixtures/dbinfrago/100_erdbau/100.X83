                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;DPr &#x3e;95%, 97%, 100%&#x3c;)&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Abrechnung nach Abtragsprofilen. Die Verdichtung ist</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">in der Eigenüberwachung nachzuweisen. Dabei ist gemäß &#x22;Prüfkatalog für Eigenüberwachungs- und Kontrollprüfungen&#x22; des AG vorzugehen.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Bodenaustausch Material liefern MLV-ERD_01080010</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIEJEAAAA" RNoPart="0020">
          <Qty>1.000</Qty>
          <QU>m3</QU>
          <Description ID="R20190401115143187000020">
           <WICNo>DB Netz/100/01.08.0020. </WICNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Aushub für Bodenaustausch unter </span>
