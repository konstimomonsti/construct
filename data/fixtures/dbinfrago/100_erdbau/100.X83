                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;Aushubplanum/ Dammaufstandsfläche /... &#x3c;)&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> bei nicht ausreichend tragfähigem Untergrund, Homogenbereich </span>
