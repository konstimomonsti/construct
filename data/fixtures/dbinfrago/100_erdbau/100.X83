         <Item ID="AAAAAAABIEOJLKNI" RNoPart="0220">
          <Qty>1.000</Qty>
          <QU>t</QU>
          <Description ID="R20190401115143587000237">
           <WICNo>DB Netz/100/01.21.0220. </WICNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Profilstahl für Distanzringe, Aufstandskreuz mit Fußplatte etc. sowie Abstandhalter entsprechend statischen und konstruktiven Erfordernissen einschließlich aller Verbindungsmittel herstellen und montieren. </span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bauteil: Bohrpfahl</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Stahlsorte Profilstahl: </span>
               <TextComplement MarkLbl="63" Kind="Owner">
                <ComplCaption/>
