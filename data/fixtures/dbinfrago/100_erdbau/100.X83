         <Item ID="AAAAAAABIENHBDDI" RNoPart="0570">
          <Qty>1.000</Qty>
          <QU>St</QU>
          <Description ID="R20190401115143484000196">
           <WICNo>DB Netz/100/01.20.0570. </WICNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Schachtabdeckung, DIN EN 124 und DIN 1229, vollfugig auf Mörtelbett aus Fertigzementmörtel herstellen. </span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Druckfestigkeit fck, cube des Mörtels min. 20 N/mm2, </span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Zement Art CEM I, max. w/z 0,50, frost-/tausalzbeständig.   Bauteil(e): </span>
               <TextComplement MarkLbl="65" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;Ein- / Auslaufbauwerk bahnrechts / bahnlinks&#x3c;)&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">,  Abdeckung </span>
               <TextComplement MarkLbl="66" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;Klasse B 125&#x3c;)&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> mit Rahmen rund aus Gusseisen mit Beton, DIN 4271, mit Schmutzfänger, DIN 1221, Deckel mit Betonfüllung, </span>
               <TextComplement MarkLbl="67" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;belüftet / unbelüftet&#x3c;)&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
