           <WICNo>DB Netz/100/01.08.0010. </WICNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Aushub für Bodenaustausch unter </span>
               <TextComplement MarkLbl="64" Kind="Owner">
                <ComplCaption/>
