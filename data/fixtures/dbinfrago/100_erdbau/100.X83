            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIENHDDII" RNoPart="0610">
          <Qty>1.000</Qty>
          <QU>m2</QU>
          <Description ID="R20190401115143484000197">
           <WICNo>DB Netz/100/01.20.0610. </WICNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Sohl- und Böschungsbefestigung aus Großsteinpflaster aus </span>
               <TextComplement MarkLbl="66" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;Granit / XXX&#x3c;)&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> herstellen. Maße Steine </span>
               <TextComplement MarkLbl="67" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;ca. 17x 17x 17 cm&#x3c;)&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> auf Betonbett Stärke </span>
               <TextComplement MarkLbl="68" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;25 cm&#x3c;)&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">, Beton </span>
               <TextComplement MarkLbl="69" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;C 25 / 30&#x3c;)&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">, einschließlich notwendiger Erdarbeiten mit Verzahnung der Böschung zum Bestand, Fugenvermörtelung  mit Trasszementmörtel (Mindestzementgehalt 600 kg/m3). </span>
               <TextComplement MarkLbl="70" Kind="Owner">
                <ComplCaption/>
