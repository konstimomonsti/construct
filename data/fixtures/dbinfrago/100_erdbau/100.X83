          <Qty>1.000</Qty>
          <QU>m2</QU>
          <Description ID="R20191120075904751000026">
           <WICNo>DB Netz/100/01.17.0390. </WICNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Erosionsschutzmatte aus </span>
               <TextComplement MarkLbl="61" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;Kunststoffwirrgelege / Jutegewebe / Kokosgewebe&#x3c;)&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> auf Böschung mit Neigung bis </span>
               <TextComplement MarkLbl="62" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;1:1,8 / 1:1,5 / 1:1,25 / 1:1&#x3c;)&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> verlegen Befestigung mit </span>
               <TextComplement MarkLbl="63" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;Holzpflöcken / Metallnägeln / -bügeln&#x3c;)&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">, </span>
               <TextComplement MarkLbl="64" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;XXX&#x3c;)&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> Stück pro m2. Abgerechnet wird die überdeckte Fläche. Bauteil: </span>
               <TextComplement MarkLbl="65" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;XXX&#x3c;)&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">.</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;line-height:13pt;margin-top:0pt;margin-bottom:0pt;"/>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
