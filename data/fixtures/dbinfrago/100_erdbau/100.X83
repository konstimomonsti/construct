          <Qty>1.000</Qty>
          <QU>m3</QU>
          <Description ID="R20190401115143189000024">
           <WICNo>DB Netz/100/01.09.0030. </WICNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Zulage für alle Aushub-Positionen für die Ausführung in Handarbeit nach gesonderter Abstimmung mit dem AG</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">im Bereich </span>
