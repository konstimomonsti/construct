                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;Teilverdrängungspfahl / Vollverdrängungspfahl&#x3c;)&#x27;</span>
                </ComplBody>
                <ComplTail/>
