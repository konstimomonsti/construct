         <Item ID="AAAAAAABIEJOAMNI" RNoPart="1080">
          <Qty>1.000</Qty>
          <QU>m2</QU>
          <Description ID="R20190401115143492000212">
           <WICNo>DB Netz/100/01.20.1080. </WICNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Anpassung des neuen Durchlasses an vorhandene Gräben inklusive Böschungen nach Angabe des AG nachprofilieren. Boden nach Homogenbereich </span>
               <TextComplement MarkLbl="62" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;XXX&#x3c;)&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> gemäß geotechnischem Bericht.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Geländeanpassung Durchlass MLV-ERD_01201080</span>
               </p>
              </TextOutlTxt>
