           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIEOLMFFI" RNoPart="0330">
          <Qty>1.000</Qty>
          <QU>t</QU>
          <Description ID="R20190401115143436000183">
           <WICNo>DB Netz/100/01.20.0330. </WICNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bewehrung aus Betonstabstahl B500B DIN 488, alle Durchmesser, alle Längen. </span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Ausführung gemäß Zeichnung.</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bauteil(e): </span>
               <TextComplement MarkLbl="62" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;Ein- / Auslaufbauwerk bahnrechts / bahnlinks&#x3c;)&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> </span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Betonstabstahl B500B alle Durchmesser  MLV-ERD_01200330</span>
               </p>
