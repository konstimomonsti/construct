            <CompleteText>
             <DetailTxt>
              <Text>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Nach Abschluß der Arbeiten Schacht einschl</span>
                <br/>
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Schachtabdeckung aus seitlicher Lagerung einbauen.</span>
               </p>
              </Text>
