          <SubDescr>
           <SubDNo>2</SubDNo>
           <Description ID="R20210518095223898000866">
            <WICNo>Muster-LV/42.1/10.20.0250. -U:2</WICNo>
            <CompleteText>
             <DetailTxt>
              <Text>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Schutzabdeckung gegen mechanische Beschädigungen herstellen und entfernen, aus Stahlblech, auf waagerechten Flächen, begehbar, Breite über 1 bis 1,5 m.</span>
               </p>
              </Text>
             </DetailTxt>
             <OutlineText>
              <OutlTxt>
               <TextOutlTxt>
                <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                 <span>Schutzabdeck. herstellen entfernen Stahlblech B 1-1,5m</span>
                </p>
               </TextOutlTxt>
              </OutlTxt>
             </OutlineText>
             <!-- GAEB version used: 330 -->
             <!-- GAEB version used: 330 -->
            </CompleteText>
           </Description>
           <QtySpec>Yes</QtySpec>
