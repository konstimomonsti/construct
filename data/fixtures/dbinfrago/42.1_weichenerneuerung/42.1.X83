           <WICNo>Muster-LV/42.1/10.60.0070. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Filterschicht, Füllstoff, liefern, profilgerecht einbauen und verdichten, in Baugruben, Schichtdicke 100 cm, Breite der Sohle über 0,5 bis 0,8 m, zulässige Abweichung von der Sollhöhe +/- 2 cm, Kies, natürliche Gesteinskörnung TL Gestein.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Filterschicht Füllstoff liefern einbauen verdichten D 100cm Sohlen-B 0,5-0,8m Kies</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
