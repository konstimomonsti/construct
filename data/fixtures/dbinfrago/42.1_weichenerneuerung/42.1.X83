           <Qty>0.000</Qty>
          </SubDescr>
          <SubDescr>
           <SubDNo>2</SubDNo>
           <Description ID="R20210518095241650001025">
            <WICNo>Muster-LV/42.1/10.60.0050. -U:2</WICNo>
            <CompleteText>
             <DetailTxt>
              <Text>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Rohre müssen für den Einbau im</span>
                <br/>
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Inneren Druckbereich von</span>
                <br/>
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Eisenbahnverkehrslasten zugelassen sein</span>
               </p>
              </Text>
