               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Gleisbereiche.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Sicherungsmaßnahmen Nacharbeiten</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIPAJEOII" RNoPart="0040">
          <LumpSumItem>Yes</LumpSumItem>
          <Qty>1.000</Qty>
          <QU>psch</QU>
          <CtlgAssign>
           <CtlgID>AAAAAAABIOKJJEBI</CtlgID>
           <CtlgCode>000</CtlgCode>
          </CtlgAssign>
          <Description ID="R20210518095244574001048">
           <WICNo>Muster-LV/42.1/10.70.0040. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Planung und Durchführung der vorgegebenen</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Sicherungsmaßnahmen zur Abwendung der Gefahren</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">aus dem Bahnbetrieb bei Arbeiten im Gleisbereich.</span>
               <br/>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Umfang der Sicherungsmaßnahmen:</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">alle während der  zeitlichen Vorgaben für die</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Durchführung der Belastungsstopfung betroffenen</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Gleisbereiche.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Sicherungsmaßnahmen Belastungsstopfung</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIPAJGNLI" RNoPart="0050">
          <LumpSumItem>Yes</LumpSumItem>
          <Qty>1.000</Qty>
          <QU>psch</QU>
          <CtlgAssign>
           <CtlgID>AAAAAAABIOKJJEBI</CtlgID>
           <CtlgCode>000</CtlgCode>
          </CtlgAssign>
          <Description ID="R20210518095244732001049">
           <WICNo>Muster-LV/42.1/10.70.0050. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Prüfung der ATWS-Planung auf schriftliche Anordnung der</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">für den Bahnbetrieb zuständige Stelle (BzS)</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">durchführen.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>ATWS Planprüfung</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIPAJIMGI" RNoPart="0060">
          <Qty>1.000</Qty>
          <QU>St</QU>
          <CtlgAssign>
           <CtlgID>AAAAAAABIOKJJEBI</CtlgID>
           <CtlgCode>000</CtlgCode>
          </CtlgAssign>
          <Description ID="R20210518095244928001050">
           <WICNo>Muster-LV/42.1/10.70.0060. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Schutzhaltsignal (Sh2) als Tages- und Nachtzeichen</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">auf- und abbauen, einschließlich An- und Abtransport,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">ggf. umsetzen bzw. temporäre Herstellung der</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Profilfreiheit, vorhalten, betreiben,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">ggf. außer- und wieder in Betrieb setzen.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Einschl. Betriebsstoffe und Energieversorgung.</span>
               <br/>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Umfang der Signalisierungsmaßnahme:</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Signalisierung aller für die Durchführung der</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Baumaßnahme gesperrten Gleise, während der zeitlichen</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Vorgaben, in denen Gleissperrungen erforderlich sind.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Signalisierung: Sh2-Signale</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIPAJKMII" RNoPart="0070">
          <Qty>1.000</Qty>
          <QU>St</QU>
          <CtlgAssign>
           <CtlgID>AAAAAAABIOKJJEBI</CtlgID>
           <CtlgCode>000</CtlgCode>
          </CtlgAssign>
          <Description ID="R20210518095245111001051">
           <WICNo>Muster-LV/42.1/10.70.0070. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Langsamfahrsignale Lf 1 und Lf 2/3, ggf. m.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Richtungspfeil, als Tages- und Nachtzeichen auf- und abbauen,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">einschließlich An- und Abtransport, ggf. umsetzen,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">vorhalten, betreiben, ggf. anpassen an wechselnde</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Geschwindigkeiten bzw. Herstellung der Gültig- bzw. Ungültigkeit.</span>
               <br/>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Umfang der Signalisierungsmaßnahme:</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Signalisierung aller für die Durchführung der</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Baumaßnahme erforderlichen Langsamfahrstellen, während</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">der zeitlichen Vorgaben, in denen Langsamfahrstellen</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">erforderlich sind.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Signalisierung: Lf-Signale</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIPAJMNBA" RNoPart="0080">
          <Qty>1.000</Qty>
          <QU>St</QU>
          <CtlgAssign>
           <CtlgID>AAAAAAABIOKJJEBI</CtlgID>
           <CtlgCode>000</CtlgCode>
          </CtlgAssign>
          <Description ID="R20210518095245288001052">
           <WICNo>Muster-LV/42.1/10.70.0080. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Signal EL 6 &#x22;Halt für Fahrzeuge mit gehobenem</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Stromabnehmer&#x22;, rückstrahlend, auf- und abbauen,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">einschließlich An- und Abtransport, ggf. umsetzen,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">vorhalten,</span>
               <br/>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Umfang der Signalisierungsmaßnahme:</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Signalisierung aller für die Durchführung der</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Baumaßnahme erforderlichen Standorte, während</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">der zeitlichen Vorgaben, in denen die Signalisierung</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">erforderlich ist.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Signalisierung: Signal El 6</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIPAJOMKI" RNoPart="0090">
          <Qty>1.000</Qty>
          <QU>St</QU>
          <CtlgAssign>
           <CtlgID>AAAAAAABIOKJJEBI</CtlgID>
           <CtlgCode>000</CtlgCode>
          </CtlgAssign>
          <Description ID="R20210518095245483001053">
           <WICNo>Muster-LV/42.1/10.70.0090. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Baugleismagnet(e) 500 Hz oder 1000 Hz, für</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">vorübergehende</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Langsamfahrstelle entsprechend Ril 892.9107A02 einbauen</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">und in Betrieb nehmen, bei Aufhebung der</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">vorübergehenden</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Langsamfahrstelle ausbauen und außer Betrieb nehmen,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">ggf. bei zeitweiliger Aufhebung der Langsamfahrstelle</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">ausbauen, damit außer Betrieb nehmen, und wieder</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">einbauen, damit wieder in Betrieb nehmen,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">ggf. umsetzen.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Inkl. An-/Abtransport der vom/zum Lagerort des AG.</span>
               <br/>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Umfang der Maßnahme:</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Absicherung aller für die Durchführung der Baumaßnahme</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">erforderlichen Langsamfahrstellen,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">während der zeitlichen Vorgaben, in denen</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Langsamfahrstellen erforderlich sind.</span>
               <br/>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Signalisierung: Gleismagnet(e) des AG</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIPAIANGI" RNoPart="0100">
          <Qty>1.000</Qty>
          <QU>St</QU>
          <CtlgAssign>
           <CtlgID>AAAAAAABIOKJJEBI</CtlgID>
           <CtlgCode>000</CtlgCode>
          </CtlgAssign>
          <Description ID="R20210518095245670001054">
           <WICNo>Muster-LV/42.1/10.70.0100. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Baugleismagnet(e) 500 Hz oder 1000 Hz, für</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">vorübergehende</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Langsamfahrstelle entsprechend Ril 892.9107A02 einbauen</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">und in Betrieb nehmen, bei Aufhebung der</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">vorübergehenden</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Langsamfahrstelle ausbauen und außer Betrieb nehmen</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">ggf. bei zeitweiliger Aufhebung der Langsamfahrstelle</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">ausbauen, damit außer Betrieb nehmen, und wieder</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">einbauen, damit wieder in Betrieb nehmen,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">ggf. umsetzen,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Gleismagnet(e) am Einbauort bereitstellen und nach dem</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Ausbauen vom Einbauort entfernen.</span>
               <br/>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Umfang der Maßnahme:</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Absicherung aller für die Durchführung der Baumaßnahme</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">erforderlichen Langsamfahrstellen,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">während der zeitlichen Vorgaben, in denen</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Langsamfahrstellen erforderlich sind.</span>
               <br/>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Signalisierung: Gleismagnet(e) des AN</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIPAICOLI" RNoPart="0110">
          <Qty>1.000</Qty>
          <QU>h</QU>
          <CtlgAssign>
           <CtlgID>AAAAAAABIOKJJEBI</CtlgID>
           <CtlgCode>000</CtlgCode>
          </CtlgAssign>
          <Description ID="R20210518095245846001055">
           <WICNo>Muster-LV/42.1/10.70.0110. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Stundenverrechnungssatz je Arbeitsstunde für</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Einsatz von Personal als Bahnerdungsberechtigten.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Durchführung der Bahnerdungen in dem erforderlichen</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Umfang, inkl. Nebenkosten und Zuschlägen.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Einsatz Bahnerdungsberechtigter</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIPAIENEI" RNoPart="0120">
          <Qty>1.000</Qty>
          <QU>St</QU>
          <CtlgAssign>
           <CtlgID>AAAAAAABIOKJJEBI</CtlgID>
           <CtlgCode>000</CtlgCode>
          </CtlgAssign>
          <Description ID="R20210518095245954001056">
           <WICNo>Muster-LV/42.1/10.70.0120. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Beistellung der Erdungsbestecke und der Spannungsprüfer.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Erdungsbesteck bestehend aus Erdungsstangen zur</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">profilfreien Erdung einschl. Erdungsseile und</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Spannungsprüfer gemäß VDE 0681 in ausreichender Anzahl.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Erdungsbesteck einschl Spannungsprüfer</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIPAIGLMI" RNoPart="0130">
          <Qty>1.000</Qty>
          <QU>h</QU>
          <CtlgAssign>
           <CtlgID>AAAAAAABIOKJJEBI</CtlgID>
           <CtlgCode>000</CtlgCode>
          </CtlgAssign>
          <Description ID="R20210518095246146001057">
           <WICNo>Muster-LV/42.1/10.70.0130. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Stundenverrechnungssatz je Arbeitsstunde für</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Einsatz von Personal als Bahnübergangsposten.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Sicherung des Straßenverkehrs vor Gefahren aus dem</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Eisenbahnbetrieb an einem Bahnübergang.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Die Beistellung von Hilfsmitteln (Absperrmittel,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Kommunikationsmittel) ist enthalten.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Die technische BÜ-Sicherung ist nicht in Betrieb.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bahnübergangsposten, inkl. Nebenkosten und Zuschlägen.</span>
               <br/>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Einsatz Bahnübergangsposten</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
