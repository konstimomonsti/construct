          <Description ID="R20210518095224998000876">
           <WICNo>Muster-LV/42.1/10.20.0300. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Eingleisstelle für den AG herstellen, vorhalten und zurückbauen,inklusive Zufahrt, Aufstelllänge des Fahrzeugs bis 12m, Gewicht des Fahrzeugs bis 28t,Hebe- und Fahrzeuge stellt der AN, inkl. Lieferung, Abtransport und allen erforderlichen Ladearbeiten</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
