            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Vollrohrleitung</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Druckrohr für den Gleisbereich,</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">als Stahlrohr,</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Nennweite DN 100</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">unter Berücksichtigung der </span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">gängigen technischen Regelwerke</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">sowie der Einbauanleitung des </span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Herstellers einbauen,</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">unter Gleisen,</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Überdeckung Schwellenunterkante -</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Rohrscheitel &#x3e;= 1,50m</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Vollrohrleitung</span>
                <br/>
                <span>Druckrohr für den</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
          <SumDescr>Yes</SumDescr>
          <SubDescr>
           <SubDNo>1</SubDNo>
           <Description ID="R20210518095241903001027">
            <WICNo>Muster-LV/42.1/10.60.0060. -U:1</WICNo>
            <CompleteText>
             <DetailTxt>
              <Text>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Einschl. aller erforderlichen Erdarbeiten,</span>
               </p>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Anschlüße an die Entwässerungsschächte</span>
               </p>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">herstellen, einsanden der Rohre, verfüllen des Grabens</span>
               </p>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">und ordnungsgemäßes stopfen der Schwellen.</span>
               </p>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Ausführung im Zusammenhang mit der Gleiserneuerung</span>
               </p>
              </Text>
             </DetailTxt>
             <OutlineText>
              <OutlTxt>
               <TextOutlTxt>
                <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                 <span>Einschl. aller erforderlichen</span>
                </p>
               </TextOutlTxt>
              </OutlTxt>
             </OutlineText>
             <!-- GAEB version used: 330 -->
             <!-- GAEB version used: 330 -->
            </CompleteText>
           </Description>
           <QtySpec>Yes</QtySpec>
           <Qty>0.000</Qty>
          </SubDescr>
          <SubDescr>
           <SubDNo>2</SubDNo>
           <Description ID="R20210518095242019001028">
            <WICNo>Muster-LV/42.1/10.60.0060. -U:2</WICNo>
            <CompleteText>
             <DetailTxt>
              <Text>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Rohre müssen der Anlage 1, „Bemessungstabellen für Stahlrohre“ des DVGW-Merkblattes GW 312/ATV-Arbeitsblatt </span>
               </p>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">A 161 entsprechen und für den Einbau im Druckbereich von Eisenbahnverkehrslasten zugelassen sein.</span>
               </p>
              </Text>
             </DetailTxt>
             <OutlineText>
              <OutlTxt>
               <TextOutlTxt>
                <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                 <span>Rohre müssen der Anlage 1,</span>
                </p>
               </TextOutlTxt>
              </OutlTxt>
             </OutlineText>
             <!-- GAEB version used: 330 -->
             <!-- GAEB version used: 330 -->
            </CompleteText>
           </Description>
           <QtySpec>Yes</QtySpec>
           <Qty>0.000</Qty>
          </SubDescr>
         </Item>
