           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Schiene abladen, von Bahnwagen, im Baustellenbereich, neben dem Gleis lagern, Schiene gegen Verrutschen, Verschieben und Verkanten sichern, Schienenlänge über 18 bis 30 m.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
