         <Item ID="AAAAAAABIOPPKBAI" RNoPart="0310">
          <Qty>1.000</Qty>
          <QU>m</QU>
          <Description ID="R20210518095225108000877">
           <WICNo>Muster-LV/42.1/10.20.0310. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Kabeltrogstrecken ( Kabelkanal b= 0 ,10m - 0 ,40m ) während</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">der Bauzeit vor Beschädigungen schützen ( mit Holzbohlen</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">o. ä . ).</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">gegen kippen sichern</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Kabelkanal sichern</span>
