            <WICNo>Muster-LV/42.1/10.60.0070. -U:1</WICNo>
            <CompleteText>
             <DetailTxt>
              <Text>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">D10 &#x3e;0,1 mm</span>
               </p>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">ID &#x3e;= 0,33</span>
               </p>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Anteil löslicherBestandteile &#x3c; 1%</span>
               </p>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Anteil organischer Beimengungen &#x3c; 1%</span>
               </p>
              </Text>
             </DetailTxt>
             <OutlineText>
              <OutlTxt>
               <TextOutlTxt>
                <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                 <span>D10 &#x3e;0,1 mm</span>
                 <br/>
                 <span>ID &#x3e;= 0,33</span>
                 <br/>
