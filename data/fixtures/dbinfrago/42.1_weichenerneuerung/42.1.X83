         <Item ID="AAAAAAABIOPPNNOI" RNoPart="0330">
          <LumpSumItem>Yes</LumpSumItem>
          <Qty>1.000</Qty>
          <QU>psch</QU>
          <Description ID="R20210518095225350000879">
           <WICNo>Muster-LV/42.1/10.20.0330. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">LST- Material (Neustoffe und Altstoffe) , in Gitterboxen</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">gelagert, von Bahnwagen abladen bzw. vom Lagerplatz</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">des Nbez. zur Montagestelle und von der Demontagestelle</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">zum Lagerplatz des Nbez. t ransportieren, einschließlich</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">auf- und abladen der Gitterboxen nach Anweisung des</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Fachdienst LST, einschließlich Längstransport innerhalb der Baustelle.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>LST - Material transportieren, abladen</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
