         <Item ID="AAAAAAABIOONPCNI" RNoPart="0020">
          <LumpSumItem>Yes</LumpSumItem>
          <Qty>1.000</Qty>
          <QU>psch</QU>
          <Description ID="R20260312152425635000028">
           <WICNo>Muster-LV/42.1/10.20.0020. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Erstellen, Führen, Abschließen, Übergeben einer Einbaudokumentation gemäß §22 und §25 der Ersatzbaustoffverordnung (EBV) im System ZEDAL-EBV </span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Einbaudokumentation gemäß § 22 und §25 EBV</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
          <SumDescr>Yes</SumDescr>
          <SubDescr>
           <SubDNo>1</SubDNo>
           <Description ID="R20260312152425645000029">
            <WICNo>Muster-LV/42.1/10.20.0020. -U:1</WICNo>
            <CompleteText>
             <DetailTxt>
              <Text>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Der Auftragnehmer (AN) ist gemäß EBV Verwender der mineralischen Ersatzbaustoffe (mEB), die er im Auftrag des Auftragsgebers (AG) in technische Bauwerke / Bauweisen gem. Anlage 2 + 3 EBV einbaut. Der AN hat daher grundsätzlich eine vollständige elektronische Einbaudokumentation für alle von ihm in technische Bauwerke des AG eingebauten mEB im System ZEDAL-EBV zu erstellen, unabhängig davon, ob die mEB von ihm geliefert oder vom AG beigestellt werden.</span>
               </p>
              </Text>
             </DetailTxt>
             <OutlineText>
              <OutlTxt>
               <TextOutlTxt>
                <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                 <span>Auftragnehmer ist gemäß EBV Verwender</span>
                </p>
               </TextOutlTxt>
              </OutlTxt>
             </OutlineText>
             <!-- GAEB version used: 330 -->
             <!-- GAEB version used: 330 -->
            </CompleteText>
           </Description>
           <QtySpec>Yes</QtySpec>
           <Qty>0.000</Qty>
          </SubDescr>
          <SubDescr>
           <SubDNo>2</SubDNo>
           <Description ID="R20260312152425645000030">
            <WICNo>Muster-LV/42.1/10.20.0020. -U:2</WICNo>
            <CompleteText>
             <DetailTxt>
              <Text>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Erläuterungen zur Einbaudokumentation im System ZEDAL-EBV sind den technischen Vorbemerkungen, Punkt  0.2.15.2.10.4  zur Ausschreibung zu entnehmen.</span>
               </p>
              </Text>
             </DetailTxt>
             <OutlineText>
              <OutlTxt>
               <TextOutlTxt>
                <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                 <span>Erläuterungen</span>
                </p>
               </TextOutlTxt>
              </OutlTxt>
             </OutlineText>
             <!-- GAEB version used: 330 -->
             <!-- GAEB version used: 330 -->
            </CompleteText>
           </Description>
           <QtySpec>Yes</QtySpec>
           <Qty>0.000</Qty>
          </SubDescr>
         </Item>
