                 <span>Abfall nicht gefährlich AVV170302 LKW AN transp. entsorgen Vergüt.Entsorg. AN</span>
                </p>
               </TextOutlTxt>
              </OutlTxt>
             </OutlineText>
             <!-- GAEB version used: 330 -->
             <!-- GAEB version used: 330 -->
            </CompleteText>
