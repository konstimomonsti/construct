                </ComplTail>
               </TextComplement>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">mit Aufstellvorrichtung, mit Standsicherheitsnachweis, neben der Fahrbahn, TL Aufstellvorrichtungen, vorhalten,</span>
               <br/>
               <TextComplement MarkLbl="2" Kind="Owner" ArtChrIdent="-6476">
                <ComplCaption>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Positionsmenge = Produkt aus </span>
