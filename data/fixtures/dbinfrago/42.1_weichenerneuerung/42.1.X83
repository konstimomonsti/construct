           <WICNo>Muster-LV/42.1/10.30.0120. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Ausbauen der Bahnübergangsbefestigung, Asphalt-Bauweise, Asphaltschicht Dicke über 15 bis 20 cm, ausgebaute Stoffe auf LKW des AN laden, Transportweg über 10 bis 20 km, einschl. Abladen auf Zwischenlagerfläche.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Bahnübergangsbefestigung ausbauen Asphalt D 15-20cm</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
          <SumDescr>Yes</SumDescr>
          <SubDescr>
           <SubDNo>1</SubDNo>
           <Description ID="R20210518095232099000936">
            <WICNo>Muster-LV/42.1/10.30.0120. -U:1</WICNo>
            <CompleteText>
             <ComplTSB>Yes</ComplTSB>
             <DetailTxt>
              <Text>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bau- und Abbruchabfälle, Bitumengemische, Kohlenteer und teerhaltige Produkte, nicht gefährlich, Abfallschlüssel nach AVV (Abfallverzeichnis-Verordnung) 170302 Bitumengemische, </span>
                <br/>
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">nicht schadstoffbelastet, auf Baustelle lagernd, laden, mit LKW des AN transportieren, entsorgen, max. Gesamtgewicht ohne Beschränkung, zum Lager/zur Anlage nach Wahl des AN, </span>
               </p>
               <TextComplement MarkLbl="1" Kind="Bidder" Empty="Yes">
                <ComplCaption>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Anlage (Bezeichnung/Ort) </span>
                </ComplCaption>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;....................................................&#x27;</span>
                </ComplBody>
                <ComplTail>
                 <br/>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">vom Bieter einzutragen,</span>
                </ComplTail>
               </TextComplement>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <br/>
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Vergütung der Entsorgung übernimmt AN.</span>
               </p>
              </Text>
             </DetailTxt>
             <OutlineText>
              <OutlTxt>
               <TextOutlTxt>
