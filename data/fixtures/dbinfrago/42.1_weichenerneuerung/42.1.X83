            <CompleteText>
             <DetailTxt>
              <Text>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Einschließlich Prüfung Einbauqualität AN für PSS</span>
                <br/>
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Dokumentation 2-fach an AG</span>
