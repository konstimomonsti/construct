  <BoQ ID="AAAAAAABMNMJAAAA">
   <BoQInfo>
    <Name>SPGK</Name>
    <LblBoQ>Abrechnung Stoffpreisgleitklausel</LblBoQ>
    <Date>2023-04-04</Date>
    <OutlCompl>AllTxt</OutlCompl>
    <BoQBkdn>
     <Type>BoQLevel</Type>
     <LblBoQBkdn>Bereich</LblBoQBkdn>
     <Length>2</Length>
     <Num>Yes</Num>
    </BoQBkdn>
    <BoQBkdn>
     <Type>BoQLevel</Type>
     <LblBoQBkdn>Abschnitt</LblBoQBkdn>
     <Length>2</Length>
     <Num>Yes</Num>
    </BoQBkdn>
    <BoQBkdn>
     <Type>Item</Type>
     <Length>4</Length>
     <Num>Yes</Num>
    </BoQBkdn>
    <BoQBkdn>
     <Type>Index</Type>
     <Length>1</Length>
     <Num>No</Num>
     <Alignment>left</Alignment>
    </BoQBkdn>
   </BoQInfo>
   <BoQBody>
    <Remark ID="AAAAAAABMNMJDECI">
     <Description>
      <WICNo>Muster-LV übergreifend/SPGK/</WICNo>
      <CompleteText>
       <DetailTxt>
        <Text>
         <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Helvetica;font-size:10pt;Color:rgb(0,0,0);">Bearbeitungshinweise und Erläuterung.</span>
         </p>
         <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
         <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Helvetica;font-size:10pt;Color:rgb(0,0,0);">Ein Abschnitt hat mit der Index-Nummer/Bezeichnung (Index) zu beginnen. </span>
         </p>
         <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
         <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Helvetica;font-size:10pt;Color:rgb(0,0,0);">Ergänzend ist eine Position für den jeweiligen Index/Stoff gemäß Anlage 2.23 Stoffpreisgleitklausel einzufügen (eine Position je Stoff/Indexwert ist möglich, wenn gemäß Finanzierung/Kontierung zulässig).</span>
         </p>
         <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
         <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Helvetica;font-size:10pt;Color:rgb(0,0,0);">Beispiel Aufbau: </span>
         </p>
         <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Wingdings 10;font-size:10pt;Color:rgb(0,0,0);">à</span>
          <span style="font-family:Helvetica;font-size:10pt;Color:rgb(0,0,0);"> GP 09-2410 </span>
          <span style="font-family:Wingdings 10;font-size:10pt;Color:rgb(0,0,0);">à</span>
          <span style="font-family:Helvetica;font-size:10pt;Color:rgb(0,0,0);"> Kurztext ist GP 09-2410 Abrechnung Stahl.</span>
         </p>
         <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
         <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Helvetica;font-size:10pt;Color:rgb(0,0,0);">Ist die Verwendung von Mischkontierung oder Mengensplitt nicht möglich, kann eine Aufteilung nach Kontierungen erfolgen. Hierfür sind beispielsweise Kontierung X und Kontierung Y zu verwenden.</span>
         </p>
         <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
         <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Helvetica;font-size:10pt;Color:rgb(0,0,0);">Beispiele Aufbau:</span>
         </p>
         <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Wingdings 10;font-size:10pt;Color:rgb(0,0,0);">à</span>
          <span style="font-family:Helvetica;font-size:10pt;Color:rgb(0,0,0);"> GP 09-2410 Abrechnung Stahl Kontierung X</span>
         </p>
         <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Wingdings 10;font-size:10pt;Color:rgb(0,0,0);">à</span>
          <span style="font-family:Helvetica;font-size:10pt;Color:rgb(0,0,0);"> GP 09-2410 Abrechnung Stahl Kontierung Y</span>
         </p>
         <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
         <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Helvetica;font-size:10pt;Color:rgb(0,0,0);">Hinweis:</span>
         </p>
         <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Helvetica;font-size:10pt;Color:rgb(0,0,0);">In der Vorlagedatei zur Abrechnung erfolgt die Darstellung nach Index/Stoff. </span>
         </p>
         <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
          <span style="font-family:Helvetica;font-size:10pt;Color:rgb(0,0,0);">Es wird empfohlen, entsprechend  wenn möglich  nur eine Position je Index/Stoff zu verwenden.</span>
         </p>
        </Text>
       </DetailTxt>
       <OutlineText>
        <OutlTxt>
         <TextOutlTxt>
          <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
           <span>Hinweis zur Handhabung.</span>
          </p>
         </TextOutlTxt>
        </OutlTxt>
       </OutlineText>
      </CompleteText>
     </Description>
    </Remark>
