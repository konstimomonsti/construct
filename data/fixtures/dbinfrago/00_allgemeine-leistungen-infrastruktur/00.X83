  <BoQ ID="AAAAAAABIELFAAAA">
   <BoQInfo>
    <Name>00</Name>
    <LblBoQ>MLV Allgem. Leistungen Infrastruktur_05/2026</LblBoQ>
    <Date>2026-06-26</Date>
    <OutlCompl>AllTxt</OutlCompl>
    <BoQBkdn>
     <Type>BoQLevel</Type>
     <LblBoQBkdn>LV-Gruppe 1</LblBoQBkdn>
