         <Item ID="AAAAAAABKCKMBMBA" RNoPart="0180">
          <LumpSumItem>Yes</LumpSumItem>
          <Qty>1.000</Qty>
          <QU>psch</QU>
          <Description>
           <WICNo>Muster-LV/70/01.10.0180. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Koordination der Datenübergabe (EWHA/ Schnittstelle</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">zum MAS 90 System) mit den DB KT, EWHA-Lieferant,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">einschließlich der Erstellung bzw. Ergänzung/Prüfung</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">der Datenpunktlisten MAS 90 für die neue EWHA sowie</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">gemeinsamer örtl. Prüfung der Fernsteuerfunktionen mit</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">den  v.g. Firmen. koordinieren, erstellen und prüfen.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
