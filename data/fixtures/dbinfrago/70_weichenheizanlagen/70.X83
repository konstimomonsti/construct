               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Cu-Erdungsseil 35 mm2 im nächsten Schwellenfach</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">einschließlich Anschluss über zusätzlicher</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Anschlusskopfbefestigung) und Befestigungsmaterial</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">gemäß den EIh-Regelzeichnungen</span>
              </p>
              <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">- </span>
              <br/>
             </Text>
             <TextComplement MarkLbl="66" Kind="Owner">
              <ComplCaption>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">mit angegossenem Kabel </span>
              </ComplCaption>
              <ComplBody>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;...&#x3c;)&#x27;</span>
              </ComplBody>
              <ComplTail>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> m,</span>
              </ComplTail>
             </TextComplement>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">oder</span>
              </p>
              <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">- </span>
              <br/>
             </Text>
             <TextComplement MarkLbl="67" Kind="Owner">
              <ComplCaption>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">mit angeschraubtem Kabel </span>
              </ComplCaption>
              <ComplBody>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;...&#x3c;)&#x27;</span>
