         <Item ID="AAAAAAABIEDKJNAA" RNoPart="2270">
          <Qty>0.000</Qty>
          <QU>St</QU>
          <Description>
           <WICNo>DB Netz/40/04.05.2270. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Pumpenanlage aufbauen und abbauen</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Pumpenanlage aus einer oder mehrere Pumpen zum</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Freihalten oder Trockenlegen der Baugrube</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">betriebsbereit aufbauen und nach Einsatz abbauen.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Vorhalten und Betreiben werden gesondert vergütet.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Förderdurchfluss über 10 bis 15 m 3/h.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Geodätische Förderhöhe ab Baugrubensohle bis 4 m.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Entfernung zum Vorfluter max. 30 m</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Pumpenanlage zur Grundwasserabsenkung aufbauen und abbauen</span>
                <br/>
                <span>MLV-FSB_04052270</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
           </CompleteText>
          </Description>
         </Item>
