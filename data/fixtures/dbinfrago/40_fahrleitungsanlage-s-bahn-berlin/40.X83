             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Umlenkungsbausatz für Betonkabelkanal Gr. IIIa mit innenliegenden Deckel ausbauen</span>
                <br/>
                <span>MLV-FSB_04014140</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
           </CompleteText>
          </Description>
         </Item>
