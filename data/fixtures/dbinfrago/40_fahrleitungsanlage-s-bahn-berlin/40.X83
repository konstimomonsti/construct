           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Umlenkungsbausatz für Betonkabelkanal Gr. IIIa mit</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">innenliegenden Deckel ausbauen</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Umlenkungsbausatz 15° bzw. 30°</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Ein Umlenkungsbausatz besteht aus 2 Trogteilstücken deren</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Stoßflächen um 7,5° bzw. 15° abgeschrägt sind.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Erd- und Schotterarbeiten werden gesondert vergütet.</span>
              </p>
             </Text>
            </DetailTxt>
