         <Item ID="AAAAAAABIEKGDGIA" RNoPart="2090">
          <Qty>0.000</Qty>
          <QU>m3</QU>
          <Description>
           <WICNo>DB Netz/40/04.04.2090. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Boden lösen, laden, fördern und einbauen</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">profilgerechter Einbau in den Auftragsstellen</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">einschließlich lagenweise verdichten.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Abweichung bei der Sollhöhe Planum: + 3 cm bis - 3 cm.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bodenklasse 3 - 5</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Boden lagert im Baustellenbereich.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Abgerechnet wird nach Auftragsprofilen.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Boden lösen, laden, fördern und einbauen</span>
                <br/>
                <span>MLV-FSB_04042090</span>
               </p>
