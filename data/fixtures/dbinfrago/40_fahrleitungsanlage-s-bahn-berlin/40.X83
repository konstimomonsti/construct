           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Ankerschiene und Kabelschellen für Parallelen Rückleiter liefern, abladen und fachgerecht lagern</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Zur Sicherung des Parallelen Rückleiters im Betonkabelkanal,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">ca. alle 3-5 m.</span>
               <br/>
