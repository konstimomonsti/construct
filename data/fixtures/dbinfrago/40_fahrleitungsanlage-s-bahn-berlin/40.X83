            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Anhebungsbausatz 30° für Betonkabelkanal Gr. IV mit innenliegenden Deckel liefern, abladen, fachgerecht lagern und einbauen</span>
                <br/>
                <span>MLV-FSB_04010940</span>
               </p>
              </TextOutlTxt>
