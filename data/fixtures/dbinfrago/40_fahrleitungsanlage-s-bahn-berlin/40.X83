           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Handtrenner liefern, abladen und fachgerecht lagern</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Einbau an Alumnium-Stahl- und / oder Weicheisenstromschiene.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Position schließt die Lieferung von Befestigungsmaterialien ein.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Lieferung frei Baustelle / Einbaustelle.</span>
