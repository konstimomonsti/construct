       <span>Längskettenwerk</span>
      </p>
     </LblTx>
     <BoQBody>
      <BoQCtgy ID="AAAAAAABKLLFBCDA" RNoPart="01">
       <LblTx>
        <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
         <span>Längskettenwerk betriebsfertig verlegen</span>
