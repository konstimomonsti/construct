         <Item ID="AAAAAAABKLKPHOLI" RNoPart="0400">
          <Qty>1.000</Qty>
          <PredQty>1.000</PredQty>
          <QU>St</QU>
          <Description>
           <WICNo>DB Netz/80/02.01.0400. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Leistung, Einmessen für Gründungsleistungen bei</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">vorhandenem Bestandsgleis mit Messrad, Bandmaß o.ä.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Leistung, Einmessen für Gründungsleistungen mit Gleis</span>
                <br/>
                <span>MLV-OLA_02010400</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABKLKPJHFI" RNoPart="0500">
          <Qty>1.000</Qty>
          <PredQty>1.000</PredQty>
          <QU>St</QU>
          <Description>
           <WICNo>DB Netz/80/02.01.0500. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Fundamentstandort für Gründungsleistungen einmessen bei</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">nicht vorhandenem Bestandsgleis durch Vermesser</span>
              </p>
             </Text>
