              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Leistung, Einmessen für Gründungsleistungen ohne Gleis</span>
                <br/>
                <span>MLV-OLA_02010500</span>
