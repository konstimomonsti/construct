          </Description>
         </Item>
         <Item ID="AAAAAAABKMAGAFFI" RNoPart="0300">
          <Qty>1.000</Qty>
          <PredQty>1.000</PredQty>
          <QU>d</QU>
          <Description>
           <WICNo>DB Netz/80/22.02.0300. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:DB Office;font-size:10pt;Color:rgb(0,0,0);">Vorhalten einer mobilen Eingleisstelle pro Tag</span>
