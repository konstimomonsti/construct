          <QU>psch</QU>
          <Description>
           <WICNo>DB Netz/80/22.01.0500. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Weitere für die Durchführung der Arbeiten erforderliche</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">behördliche Genehmigungen (z.B. Gewerbeaufsichtsamt,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Verkehrsbehörden usw...)</span>
