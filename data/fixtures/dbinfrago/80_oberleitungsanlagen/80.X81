         <Item ID="AAAAAAABKLKOOOLI" RNoPart="0300">
          <LumpSumItem>Yes</LumpSumItem>
          <Qty>1.000</Qty>
          <PredQty>1.000</PredQty>
          <QU>psch</QU>
          <Description>
           <WICNo>DB Netz/80/01.02.0300. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Erstellen von vektorisierten Bestandsplänen im</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">DGN/DWG-Format nach Schnittstellenbeschreibung</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Oberleitung gemäß dem in der Leistungsbeschreibung</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">definierten Umfang und Bereich (Ivl-Blattschnitt)</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Grundlage: Die Bestandsdateien werden in nicht</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">vektorisierter Form als Raster-/Pixeldatei übergeben</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">und sind in das CAD-Format ohne Rasteranteile zu</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">überführen.</span>
              </p>
             </Text>
