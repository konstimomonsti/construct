      <BoQCtgy ID="AAAAAAABKLKOKJGI" RNoPart="02">
       <LblTx>
        <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
         <span>Revisionsplanung</span>
        </p>
       </LblTx>
       <BoQBody>
        <Itemlist>
         <Item ID="AAAAAAABKLKOLNCA" RNoPart="0100">
          <LumpSumItem>Yes</LumpSumItem>
          <Qty>1.000</Qty>
          <PredQty>1.000</PredQty>
          <QU>psch</QU>
          <Description>
           <WICNo>DB Netz/80/01.02.0100. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Erstellen der Hand-Revision im Papier-Format zur</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Abnahme. Diese Leistungen sind Grundlage für die Pos.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">01.02.0400 und werden separat vergütet.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Grundlage: Die freigegebene  Ausführungsunterlage ist</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">handschriftlich um die Veränderungen während des</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Baus zu berichtigen und zur Abnahme vorzulegen.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Erstellen der Handrevision (Braun-Einträge)</span>
                <br/>
                <span>MLV-OLA_01020100</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABKLKONFMI" RNoPart="0200">
          <LumpSumItem>Yes</LumpSumItem>
          <Qty>1.000</Qty>
          <PredQty>1.000</PredQty>
          <QU>psch</QU>
          <Description>
           <WICNo>DB Netz/80/01.02.0200. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Erstellen von vektorisierten Bestandsplänen im</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">DGN/DWG-Format nach Schnittstellenbeschreibung</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Oberleitung für den in der Leistungsbeschreibung</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">definierten Baubereiche</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">(von km xxx bis km xxx und Gleisnummer)</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Erstellen vektorisierter Bestandspläne veränderter</span>
                <br/>
                <span>Anlagen (Baubereich)</span>
                <br/>
                <span>MLV-OLA_01020200</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
           </CompleteText>
          </Description>
