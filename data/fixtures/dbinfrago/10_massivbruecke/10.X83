         <Remark ID="AAAAAAABIGPLFLPA">
          <Description ID="R20251201132522471000001">
           <WICNo>DB Netz/10/01.05.</WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">***HINWEIS FÜR DEN LV-ERSTELLER</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">(diesen gesamten Hinweistext bitte nach Fertigstellung des LV löschen)***:</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Die nachfolgenden Positionen zur Untersuchung von Gefahrstoffen im Bauwerk sind in das LV mit aufzunehmen, wenn zum Zeitpunkt der Ausschreibung keine entsprechenden Voruntersuchungen vorliegen UND wenn der AN mit der Durchführung der Deklarationsanalytik beauftragt wird (s. hierzu Baubeschreibung Kap. 0.2.15.9).</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>HINWEIS FÜR DEN LV-ERSTELLER</span>
               </p>
              </TextOutlTxt>
