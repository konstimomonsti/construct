         <Remark ID="AAAAAAABIHAFGEKI">
          <Description ID="R20180621142236223000258">
           <WICNo>DB Netz/10/01.13.</WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">RANDKAPPEN UND KABELKANÄLE</span>
              </p>
             </Text>
            </DetailTxt>
