            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIHAFACEA" RNoPart="0130">
          <Qty>0.000</Qty>
          <QU>St</QU>
          <Description ID="R20180621142235983000255">
           <WICNo>DB Netz/10/01.13.0130. </WICNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Messbolzen in Bauwerk.</span>
               <br/>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Einbauort: </span>
               <TextComplement MarkLbl="65" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;BESCHREIBUNG / Anordnung von Messbolzen gem. RiZ-ING Mess 1 / Mess 2&#x3c;)&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">.</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <TextComplement MarkLbl="66" Kind="Owner">
               <ComplCaption>
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Material: </span>
               </ComplCaption>
               <ComplBody>
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;Stahl, feuerverzinkt&#x3c;) &#x27;</span>
               </ComplBody>
               <ComplTail/>
              </TextComplement>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Schaftdurchmesser über 20 bis 30 mm,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Schaftlänge über 80 bis 120 mm.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bolzen in Aussp</span>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">arung einbauen.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Einschließlich Herstellen der Aussparung.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Messbolzen</span>
                <br/>
                <span>MLV-MBR_01130130</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
