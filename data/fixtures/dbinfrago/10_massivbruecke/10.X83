         <Item ID="AAAAAAABIHAGDBII" RNoPart="0440">
          <Qty>0.000</Qty>
          <QU>St</QU>
          <Description ID="R20180621142238471000291">
           <WICNo>DB Netz/10/01.13.0440. </WICNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Entwässerungsrohr aus Kunststoff PE-HD bzw. PP</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">zur Entwässerung der Auflagerbänke,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Durchmesser DN100,</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Einzellänge: </span>
               <TextComplement MarkLbl="61" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;ca. (&#x3e;1,00 m&#x3c;) &#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Einbaulage: geneigt in die Schalung</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">lage- und höhengerecht einbauen,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">einschließlich Siebeinlauf.</span>
               <br/>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Einbauort: Kammerwände der Widerlager</span>
               <br/>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Einbauteil Entwässerungsrohre Kammerwand</span>
                <br/>
                <span>MLV-MBR_01130430</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIHAGEIJI" RNoPart="0450">
          <Qty>0.000</Qty>
          <QU>St</QU>
          <Description ID="R20260727065554828000003">
           <WICNo>DB Netz/10/01.13.0450. </WICNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Leerrohre aus Kunststoff PE-HD bzw. PP</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">zur Durchführung der Entwässerungsleitung.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Durchmesser Leerrohr: </span>
               <TextComplement MarkLbl="61" Kind="Owner">
                <ComplCaption>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">DN </span>
                </ComplCaption>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;200&#x3c;) &#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Lage gemäß Ausführungszeichnung,</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Einzellänge: </span>
               <TextComplement MarkLbl="62" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;ca. (&#x3e;1,00 m&#x3c;) &#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Einbaulage: </span>
               <TextComplement MarkLbl="63" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;waagerecht bis schwach geneigt in Schalung&#x3c;) &#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">lage- und höhengerecht einbauen.</span>
               <br/>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Einbauort: </span>
               <TextComplement MarkLbl="64" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;Flügelwände / Widerlagerwände / Rahmenwände&#x3c;) &#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Einbauteil Leerrohre</span>
                <br/>
                <span>MLV-MBR_01130440</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Remark ID="AAAAAAABIHAGGAGA">
          <Description ID="R20180621142238601000293">
           <WICNo>DB Netz/10/01.13.</WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">WEITERE AUSSTATTUNG</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
