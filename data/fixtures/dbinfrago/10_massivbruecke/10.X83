                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Verankerung mit Fußplatte und Verbundankern nach</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">RZ A-GEL </span>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">30 bzw. 31,</span>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> inkl. Hutmuttern, Erdungsanschlüssen und -verbindern, Unterfütterung mit schwindarmem Mörtel.</span>
