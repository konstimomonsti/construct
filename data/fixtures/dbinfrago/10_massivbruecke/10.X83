          <QU>St</QU>
          <Description ID="R20250206142308916000002">
           <WICNo>DB Netz/10/01.13.0131. </WICNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Klebevermarkung als Höhen- und Lagepunkt auf Bauwerk.</span>
               <br/>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Einbauort: </span>
               <TextComplement MarkLbl="61" Kind="Owner">
