         <Item ID="AAAAAAABIGNHNFCI" RNoPart="0010">
          <Qty>0.000</Qty>
          <QU>m2</QU>
          <Description ID="R20180621142235068000242">
           <WICNo>DB Netz/10/01.13.0010. </WICNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Fläche für Abdichtung vorbereiten.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Flächen horizontal bis schwach geneigt.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Untergrund: Beton</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bauteil: </span>
               <TextComplement MarkLbl="62" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;XXX&#x3c;)&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Flächenvorbereitung gem. Ril 804.6101 Abs. 3(2).</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Kehrgut in Eigentum des AN übernehmen und entsorgen.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Horizontale Fläche für Abdichtung vorbereiten</span>
                <br/>
                <span>MLV-MBR_01130010</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIGNHOLPI" RNoPart="0020">
          <Qty>0.000</Qty>
          <QU>m2</QU>
          <Description ID="R20180621142235144000243">
           <WICNo>DB Netz/10/01.13.0020. </WICNo>
