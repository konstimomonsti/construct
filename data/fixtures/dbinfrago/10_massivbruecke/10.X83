           <WICNo>DB Netz/10/01.13.0150. </WICNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Vogel-Einflugschutz nach </span>
               <TextComplement MarkLbl="61" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;RiZ-ING VES 1,</span>
                 <br/>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Blatt 1, feststehend / RiZ-ING VES 1, Blatt 2, klappbar&#x3c;)&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">,</span>
               <br/>
