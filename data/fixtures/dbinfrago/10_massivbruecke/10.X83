         <Item ID="AAAAAAABIGNDNLNI" RNoPart="0030">
          <Qty>0.000</Qty>
          <QU>h</QU>
          <Description ID="R20180621142230716000178">
           <WICNo>DB Netz/10/01.08.0030. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Vorbeschriebene Wasserhaltungsanlage(n) </span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">überwachen und betreiben.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Abgerechnet werden nur die vom AG bestätigten Betriebsstunden.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Wasserhaltungsanlage betreiben</span>
                <br/>
                <span>MLV-MBR_01080030</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIGNDPBIA" RNoPart="0040">
          <Qty>0.000</Qty>
          <QU>St</QU>
          <Description ID="R20180621142230785000179">
           <WICNo>DB Netz/10/01.08.0040. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Notstromaggregat anfahren, betriebsbereit aufstellen</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">und nach Einsatz abbauen und abfahren.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Vorhalten und Betreiben des Aggregates werden gesondert</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">vergütet.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Aggregat als volle Kraftreserve auslegen.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Notstromaggregat für Wasserhaltungsanlage bereitstellen</span>
                <br/>
                <span>MLV-MBR_01080040</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIGNAAIGI" RNoPart="0050">
          <LumpSumItem>Yes</LumpSumItem>
          <Qty>1.000</Qty>
          <QU>psch</QU>
          <Description ID="R20180621142230860000180">
           <WICNo>DB Netz/10/01.08.0050. </WICNo>
