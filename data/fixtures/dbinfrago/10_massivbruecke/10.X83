          <Description ID="R20180621142224940000107">
           <WICNo>DB Netz/10/01.05.0230. </WICNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Abbruch der Widerlager, Flügel </span>
              </p>
              <TextComplement MarkLbl="61" Kind="Owner">
               <ComplCaption/>
               <ComplBody>
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;inkl. Fundamenten&#x3c;)&#x27;</span>
               </ComplBody>
               <ComplTail/>
              </TextComplement>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> in Abschnitten</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Abbruch aus </span>
              </p>
              <TextComplement MarkLbl="62" Kind="Owner">
               <ComplCaption/>
               <ComplBody>
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;bewehrtem / unbewehrtem Beton / Mauerwerk&#x3c;)&#x27;</span>
               </ComplBody>
               <ComplTail/>
              </TextComplement>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Festigkeit: </span>
              </p>
              <TextComplement MarkLbl="63" Kind="Owner">
               <ComplCaption/>
               <ComplBody>
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;nach Bauwerkssubstanzuntersuchung: XXXMN/m²&#x3c;) &#x27;</span>
               </ComplBody>
               <ComplTail/>
              </TextComplement>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <TextComplement MarkLbl="64" Kind="Owner">
               <ComplCaption>
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Ausführung </span>
               </ComplCaption>
               <ComplBody>
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;erschütterungsarm, lärmarm&#x3c;), &#x27;</span>
               </ComplBody>
               <ComplTail/>
              </TextComplement>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Rückbauverfahren nach Wahl des AN.</span>
              </p>
