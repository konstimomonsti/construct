         <Item ID="AAAAAAABIGNACEFI" RNoPart="0060">
          <Qty>0.000</Qty>
          <QU>h</QU>
          <Description ID="R20180621142230973000181">
           <WICNo>DB Netz/10/01.08.0060. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Notstromaggregat betreiben.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Abgerechnet werden nur die vom AG bestätigten</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Betriebsstunden.</span>
              </p>
             </Text>
            </DetailTxt>
