         <Remark ID="AAAAAAABIHABAAAA">
          <Description ID="R20180621142237129000271">
           <WICNo>DB Netz/10/01.13.</WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">FUGEN UND ÜBERGANGSKONSTRUKTIONEN</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>MLV-MBR_01130260</span>
               </p>
              </TextOutlTxt>
