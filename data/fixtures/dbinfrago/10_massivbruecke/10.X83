           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bodenaushub für Herstellung der Baugruben.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Boden im Bereich der Baugruben </span>
              </p>
              <TextComplement MarkLbl="61" Kind="Owner">
               <ComplCaption/>
               <ComplBody>
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;der Widerlager, Pfeiler, Flügel / für alle auszuführenden Leistungen&#x3c;)&#x27;</span>
               </ComplBody>
               <ComplTail/>
              </TextComplement>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> lösen, ausheben, laden, transportieren und in Haufwerken zwischenlagern.</span>
              </p>
              <TextComplement MarkLbl="62" Kind="Owner">
               <ComplCaption/>
               <ComplBody>
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;Homogenbereich &#x22;Bodenschicht&#x22;&#x3c;) &#x27;</span>
               </ComplBody>
               <ComplTail/>
              </TextComplement>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <TextComplement MarkLbl="63" Kind="Owner">
               <ComplCaption/>
               <ComplBody>
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;gemäß Geotechnischer Bericht gemäß Anlage 3.5...&#x3c;) &#x27;</span>
               </ComplBody>
               <ComplTail/>
              </TextComplement>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <TextComplement MarkLbl="64" Kind="Owner">
               <ComplCaption>
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Aushubtiefe </span>
               </ComplCaption>
               <ComplBody>
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;ca. 2,0 bis 7,0 m unter Geländeoberkante&#x3c;) &#x27;</span>
               </ComplBody>
               <ComplTail/>
