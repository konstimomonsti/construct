         <Item ID="AAAAAAABIHAFKGDA" RNoPart="0180">
          <Qty>0.000</Qty>
          <QU>t</QU>
          <Description ID="R20180621142236409000261">
           <WICNo>DB Netz/10/01.13.0180. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bewehrung aus Betonstabstahl B500B nach DIN 488, </span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">alle Durchmesser, alle Längen,</span>
               <br/>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bauteil: Randkappen</span>
              </p>
             </Text>
            </DetailTxt>
