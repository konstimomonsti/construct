           <WICNo>DB Netz/10/01.13.0430. </WICNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Lagerfuge mit Vergussmörtel mit Quellmittelzusatz zur</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Sicherstellung einer flächenhaften Lagerung vergießen,</span>
              </p>
              <TextComplement MarkLbl="61" Kind="Owner">
               <ComplCaption>
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Sockelgrößen </span>
               </ComplCaption>
               <ComplBody>
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;0,60/0,60&#x3c;)&#x27;</span>
               </ComplBody>
               <ComplTail>
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">m</span>
               </ComplTail>
              </TextComplement>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">.</span>
               <br/>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Einbauort: Lagersockel auf Widerlagern</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Lagerfuge vergießen</span>
                <br/>
                <span>MLV-MBR_01130420</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Remark ID="AAAAAAABIHAGCAHI">
          <Description ID="R20180621142238412000290">
           <WICNo>DB Netz/10/01.13.</WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">EINBAUTEILE</span>
              </p>
             </Text>
            </DetailTxt>
