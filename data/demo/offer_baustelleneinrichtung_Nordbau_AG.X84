<GAEB xmlns="http://www.gaeb.de/GAEB_DA_XML/DA84/3.2"><GAEBInfo><Version>3.2</Version><VersDate>2013-10</VersDate><Date>2026-11-22</Date><Time>09:00:00</Time><ProgSystem>BillBuild</ProgSystem><ProgName>BillBuild</ProgName></GAEBInfo><PrjInfo><NamePrj>79-222</NamePrj><LblPrj>79-222</LblPrj><Cur>EUR</Cur><CurLbl>Euro</CurLbl></PrjInfo><Award><DP>84</DP><AwardInfo><Cur>EUR</Cur><CurLbl>Euro</CurLbl></AwardInfo><BoQ ID="id16"><BoQInfo><Name>79-222</Name><LblBoQ>Baustelleneinrichtung</LblBoQ><OutlCompl>AllTxt</OutlCompl><BoQBkdn><Type>BoQLevel</Type><LblBoQBkdn>Titel</LblBoQBkdn><Length>2</Length><Num>Yes</Num></BoQBkdn><BoQBkdn><Type>BoQLevel</Type><LblBoQBkdn>Bereich</LblBoQBkdn><Length>2</Length><Num>Yes</Num></BoQBkdn><BoQBkdn><Type>Item</Type><Length>4</Length><Num>Yes</Num></BoQBkdn><BoQBkdn><Type>Index</Type><Length>1</Length><Num>No</Num></BoQBkdn></BoQInfo><BoQBody><BoQCtgy ID="id1" RNoPart="01"><LblTx><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Baustelleneinrichtung/Planung/Statik/BGK/Gerüst, SONSTIGES</span></p></LblTx><BoQBody><BoQCtgy ID="id2" RNoPart="01"><LblTx><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Baustelleinrichtung</span></p></LblTx><BoQBody><Itemlist><Item ID="id3" RNoPart="0010"><Qty>1.000</Qty><QU>PSCH</QU><UP>2064.00</UP><IT>2064.00</IT><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Baustelleneinrichtung</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">B.2.1. Baustelleneinrichtung</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Einrichten, Vorhalten über die vereinbarte</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Leistungszeit sowie Räumen der Baustelle und</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Wiederherstellen des geländes einschl. Entfernen von</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Fundamenten und Verunreinigungen, mit folgenden in den</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Pauschalpreis einzurechnenden Leistungen :</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">- Krananlage</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">- Lager- und Arbeitsplatz</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">- Baustellenbeleuchtung</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">- Kommunikationseinrichtung</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">- Sanitärcontainer</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">- Lagerraum, Werkstatt, Magazin, Unterstelleinrichtung</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">- Machine, Geräte</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die notwendigen behördlichen Genehmigungen sind Aufgabe</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">des AN. Die Mitbenutzung der gesamten BE für den AG und</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">dessen Nachunternehmer wird durch den AN</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">sichergestellt.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Leistungszeit : über die gesamte Bauzeit</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Baustelleneinrichtung</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id4" RNoPart="0020"><Qty>1.000</Qty><QU>Stck</QU><UP>154.80</UP><IT>154.80</IT><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Bauschild</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Bauschild aufstellen</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Standzeit: über die gesamte Bauzeit</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Bauschild</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id5" RNoPart="0030"><Qty>230.000</Qty><QU>m</QU><UP>12.04</UP><IT>2769.20</IT><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Bauzaun</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Bauzaun aufstellen inkl. Sichtschutz als Plane</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Bauzaun</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id6" RNoPart="0040"><Qty>2.000</Qty><QU>St</QU><UP>154.80</UP><IT>309.60</IT><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Zulage Tor</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Zulage Tor</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Zulage Tor</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id7" RNoPart="0050"><Qty>4.000</Qty><QU>St</QU><UP>154.80</UP><IT>619.20</IT><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Herstellen von Meterrissen</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Setzen von Meterrisse im Gebäude zur Nutzung der Nachfolgegewerke.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Meterisse aus Kunststoffplättchen fest an massiven Gebäudeteilen fixiert.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Herstellen von Meterrissen</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id8" RNoPart="0060"><Qty>1.000</Qty><QU>PSCH</QU><UP>2064.00</UP><IT>2064.00</IT><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Verkehrssicherung</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Verkehrssicherung</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Verkehrssicherung</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id9" RNoPart="0070"><Qty>10.000</Qty><QU>St</QU><UP>154.80</UP><IT>1548.00</IT><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schuttcontainer, 7 m3, Beton/Ziegel</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schuttcontainer für [PERSON_047] wie Beton, Ziegel, Holz oder Stahlschrott</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schuttcontainer für anfallenden [PERSON_047]</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">für die am Bau beteiligten Unternehmen</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">bereitstellen, einschl. Vorhaltung und Be-</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">seitigung auf die entsprechenden Deponien.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Als [PERSON_047] gelten grundwasserunschädliche</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Bestandteile, wie Erd-, Mauer- und Betonbrocken,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">etc. Der Schuttcontainer ist entsprechend zu kenn-</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">zeichnen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Containerinhalt: 7 m3</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schuttcontainer, 7 m3, Beton/Ziegel</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id10" RNoPart="0080"><Qty>10.000</Qty><QU>St</QU><UP>154.80</UP><IT>1548.00</IT><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schuttcontainer, 7 m3, Holz/Metall</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schuttcontainer, 7 m3, Holz/Metall</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schuttcontainer für anfallenden [PERSON_047] für</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">die am Bau beteiligten Unternehmen bereit-</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">stellen, einschl. Vorhaltung und Beseitigung</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">auf die entsprechenden Deponien zum Sortieren.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Als gemischter [PERSON_047] gelten Holzteile,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Metallteile, u.ä. Der Schuttcontainer ist ent-</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">sprechend zu kennzeichnen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Containerinhalt: 7 m3</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schuttcontainer, 7 m3, Holz/Metall</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id11" RNoPart="0090"><Qty>10.000</Qty><QU>St</QU><UP>154.80</UP><IT>1548.00</IT><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schuttcontainer, 7 m3, Restmüll</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schuttcontainer für anfallenden [PERSON_047] für</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">die am Bau beteiligten Unternehmen bereit-</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">stellen, einschl. Vorhaltung und Beseitigung</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">auf die entsprechenden Restmülldeponien.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Als Restmüll gelten Kunststoffe, Holz, Fenster,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Bodenbeläge, etc. Der Schuttcontainer ist ent-</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">sprechend zu kennzeichnen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Containerinhalt: 7 m3</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schuttcontainer, 7 m3, Restmüll</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id12" RNoPart="0100"><Qty>1.000</Qty><QU>PSCH</QU><UP>2064.00</UP><IT>2064.00</IT><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Bodengutachten</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Bodengutachten</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Bodengutachten</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id13" RNoPart="0110"><Qty>1.000</Qty><QU>PSCH</QU><UP>2064.00</UP><IT>2064.00</IT><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Baustromanschlusskosten und Vorhaltung</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Baustromanschlusskosten und Vorhaltung</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Baustromanschlusskosten und Vorhaltung</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id14" RNoPart="0120"><Qty>1.000</Qty><QU>PSCH</QU><UP>2064.00</UP><IT>2064.00</IT><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Wasseranschlusskosten und Vorhaltung</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Bauwasseranschlüsse in genügender Anzahl 8 x 1&quot; mit</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Wasseruhr,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">ausreichend dimensioniert, für die Versorgung des</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">gesamten Baustellenbetriebes, auch als Anschluß für</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Fremdfirmen nutzbar, Einrichten, Vorhalten und nach</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Fertigstellung des Bauwerks abbauen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Der Auftragnehmer hat die behördlichen Anträge für die</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Einrichtung und Beseitigung der Anlage ohne Mitwirkung</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">des Auftraggebers zu stellen, Gebühren und Nebenkosten</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">für die Beantragung sind im Pauschalpreis einzurechnen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Auf Anordnung der Bauleitung ist der Wasseranschluß ins</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Gebäude zu verlegen und gegen Frost zu schützen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Rechnungsempfänger der Wasserrechnung ist der</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Auftraggeber!</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Wasseranschlusskosten und Vorhaltung</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id15" RNoPart="0130"><Qty>1.000</Qty><QU>PSCH</QU><UP>2064.00</UP><IT>2064.00</IT><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Verbrauchskosten für Bauheizung</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Summe 1.1. Baustelleinrichtung .........................</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Verbrauchskosten für Bauheizung</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item></Itemlist></BoQBody></BoQCtgy></BoQBody></BoQCtgy></BoQBody></BoQ></Award></GAEB>