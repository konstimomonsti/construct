                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span>Erstellung von Montage-, Werkstatt- und Detailplänen für die nachfolgend beschriebenen Leistungen, auf der Grundlage der vom AG an den AN übergebenen Architektenpläne.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span>Werkstattzeichnungen</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="lv11-3.2.20" RNoPart="20">
                    <Qty>1.000</Qty>
                    <QU>St</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span>Stahlbetonfertigteil als Sandwichelement aus Beton C20/25, Expositionsklasse XC4 und XF4. Länge 6,35m, Höhe 60 cm, d = 30 cm gesamt. Dicke Vorsatzschale: 7 cm; Dicke Tragschale: 15 cm; Dämmschicht: 8 cm. Wärmedämmung aus extrudierten Polystyrol-Hartschaumplatten. Sichtbeton der Vorsatzschale durchgefärbt in RAL 7032. Werkseitige Herstellung einschließlich Bewehrung und Transportanker; Montage auf der Baustelle.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span>FS 01: FT-Sockel, Sandwichelement, C20/25</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
