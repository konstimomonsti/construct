# Virtual Environment
.venv/
venv/
ENV/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Output files
*.csv
*.json
# ...except rule sets, fixtures and examples that belong to the code
!analysis/**/*.json
!examples/*.json
# ...and the hand labels of the evaluation (real_findings.csv)
!analysis/eval/labels/*.csv

# Local database files
.env
.env.*
!.env.example
backups/
/db/seed_challenge_catalogue.sql

# Python packaging output
*.egg-info/
build/
dist/
.pytest_cache/

# Layer 3 LLM answer cache (may contain tender text)
.cache/

# Evaluation output: mutated copies of the seed (and of any file given to it), results, reports
eval_out/
