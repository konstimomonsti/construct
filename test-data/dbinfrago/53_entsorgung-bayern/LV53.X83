         <Remark ID="AAAAAAABJOPIGPPA">
          <Description ID="R20180730092835629000007">
           <WICNo>DB Netz/53/01.01.</WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Entsorgung und Transport Beton und Bauschutt </span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Calibri;font-size:11pt;Color:rgb(0,0,0);">Bauschutt und Beton sind in Bayern gemäß der jeweils gültigen</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Calibri;font-size:11pt;Color:rgb(0,0,0);">Fassung des Eckpunktepapiers (EPP) &#x22;Leitfaden zur Verfüllung</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Calibri;font-size:11pt;Color:rgb(0,0,0);">von Gruben,Brüchen und Tagebauen&#x22; (Bayerisches </span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Calibri;font-size:11pt;Color:rgb(0,0,0);">Staatsministerium fürUmwelt, Gesundheit und Verbraucherschutz) zu deklarieren. Es sind Schadstoffgehaltebis Z 2 definiert.</span>
              </p>
              <p style="margin-left:2pt;text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Calibri;font-size:11pt;Color:rgb(0,0,0);">Bei Überschreitung von EPP Z 2 erfolgt dieEntsorgung nach Deponieverordnung (DepV). Die Einstufung erfolgt in die Deponieklassen DK 0 bis DK III.</span>
              </p>
              <p style="text-indent:-2pt;margin-left:2pt;text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> </span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Entsorgung und Transport Beton und Bauschutt</span>
               </p>
              </TextOutlTxt>
