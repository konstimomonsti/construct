         <Item ID="AAAAAAABJOPJEHOA" RNoPart="0150">
          <Qty>0.000</Qty>
          <QU>t</QU>
          <Description ID="R20170119124128523000027">
           <WICNo>DB Netz/53/01.01.0150. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Entsorgung Boden DepV DK I</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">AVV 17 05 04 nicht gefährlicher Abfall und AVV 17 05 03* gefährlicher Abfall,</span>
               <br/>
