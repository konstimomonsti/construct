         <Item ID="AAAAAAABJOPJAEAI" RNoPart="0121">
          <Qty>0.000</Qty>
          <QU>t</QU>
          <Description ID="R20251107101331674000002">
           <WICNo>DB Netz/53/01.01.0121. </WICNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Entsorgung Boden (AVV 17 05 04) EPP Z 0 bis Z 2, mit biogener Belastung </span>
               <TextComplement MarkLbl="61" Kind="Owner">
                <ComplCaption/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;Japanischer Staudenknöterich/....&#x3c;)&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> mittels thermophiler Hygienisierungsphase (Heißrotte) oder Entsorgung in einer Verbrennungsanlage mit anschließender Deponierung, inklusive Verwiegung.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Zulage für Entsorgung biogen belasteter Boden MLV-ENB_01010121</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
