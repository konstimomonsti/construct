         <Remark ID="AAAAAAABIEDKMDEA">
          <Description>
           <WICNo>DB Netz/50/04.01.</WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">HINWEIS FÜR DEN LV-ERSTELLER:</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Die Einstufung als nicht gefährlicher Boden (AVV 170504) oder gefährlicher Boden (AVV 170503*) erfolgt nach  den Rechtsvorschriften des jew. Bundeslandes bzw. nach Abstimmung mit den zuständigen Abfallbehörden.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
