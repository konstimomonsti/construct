             <TextComplement MarkLbl="61" Kind="Owner">
              <ComplCaption/>
              <ComplBody>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;170101 nicht gefährlich / 170106* gefährlicher Beton&#x3c;)&#x27;</span>
              </ComplBody>
