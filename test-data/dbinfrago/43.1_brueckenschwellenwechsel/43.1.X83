           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Gebrauchsüberlassung Arbeitsgerüst Bohlenbelag</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Gebrauchsüberlassung über die Grundeinsatzzeit hinaus für Arbeitsgerüst Bohlenbelag, </span>
               <br/>
               <TextComplement MarkLbl="1" Kind="Owner">
                <ComplCaption>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Positionsmenge = Produkt aus </span>
                </ComplCaption>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;....................1................................&#x27;</span>
                </ComplBody>
                <ComplTail>
                 <br/>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">(Gebrauchsüberlassungsmenge)</span>
                </ComplTail>
               </TextComplement>
               <br/>
               <TextComplement MarkLbl="2" Kind="Owner">
                <ComplCaption>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">mal </span>
                </ComplCaption>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;....................1................................&#x27;</span>
                </ComplBody>
                <ComplTail>
                 <br/>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">(Gebrauchsüberlassungsdauer)</span>
                </ComplTail>
               </TextComplement>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bohlenbelag, flächenorientiert, Lastklasse 3 (2 kN/m2), mit einer Gerüstlage, Bohlenbelag aus Gerüstbohlen d=50 mm innerhalb der Brückenkonstuktion , Einrüstung für Montagearbeiten, Grundfläche rechteckig, direkt belastbar, </span>
               <br/>
               <TextComplement MarkLbl="3" Kind="Owner">
                <ComplCaption>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Länge Gerüst/-bauteil </span>
                </ComplCaption>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;25&#x27;</span>
                </ComplBody>
                <ComplTail>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> m, </span>
                </ComplTail>
               </TextComplement>
