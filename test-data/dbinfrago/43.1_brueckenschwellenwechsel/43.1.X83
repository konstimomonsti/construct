             <ArtChrIdent>16538</ArtChrIdent>
             <ArtChIdx>0</ArtChIdx>
             <ChVIdent>24</ChVIdent>
            </STLBBauID>
            <STLBBauID>
             <ArtChrIdent>10164</ArtChrIdent>
             <ArtChIdx>0</ArtChIdx>
             <ChVIdent>1</ChVIdent>
            </STLBBauID>
            <STLBBauID>
             <ArtChrIdent>2136</ArtChrIdent>
             <ArtChIdx>0</ArtChIdx>
             <ChVIdent>1</ChVIdent>
            </STLBBauID>
            <STLBBauID>
             <ArtChrIdent>17545</ArtChrIdent>
             <ArtChIdx>0</ArtChIdx>
             <ChVIdent>4</ChVIdent>
            </STLBBauID>
            <STLBBauID>
             <ArtChrIdent>17546</ArtChrIdent>
             <ArtChIdx>0</ArtChIdx>
             <ChVIdent>9</ChVIdent>
            </STLBBauID>
           </STLBBau>
           <WICNo>Muster-LV/43.1/10.60.0010. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Mittel- und Randbleche der Brückenabdeckung von Brückenbalken/-schwellen lösen, Länge Mittelbleche zwischen den Schienen 1,8 m, Maße der Randbleche über 2,5 bis 3 m2, aufnehmen und auf niederbordige Bahnwagen des AN vor Kopf verladen.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Mittel/Randblech lösen L 1,8m 2,5-3m2 aufnehmen laden</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
          <SumDescr>Yes</SumDescr>
          <SubDescr>
           <SubDNo>1</SubDNo>
           <Description ID="R20210518094429453000476">
            <WICNo>Muster-LV/43.1/10.60.0010. -U:1</WICNo>
            <CompleteText>
             <DetailTxt>
              <Text>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bleche transportieren und abladen, auf Bahnwagen, vom AN beigestellt, im Baustellenbereich, verteilt neben dem Gleis gelagert, Transportweg über 5000 bis 10000 m, am Baustellenlagerplatz.</span>
               </p>
              </Text>
             </DetailTxt>
             <OutlineText>
              <OutlTxt>
               <TextOutlTxt>
                <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                 <span>Bleche transportieren und abladen</span>
                </p>
               </TextOutlTxt>
              </OutlTxt>
             </OutlineText>
             <!-- GAEB version used: 330 -->
             <!-- GAEB version used: 330 -->
            </CompleteText>
           </Description>
           <QtySpec>Yes</QtySpec>
           <Qty>0.000</Qty>
          </SubDescr>
          <SubDescr>
           <SubDNo>2</SubDNo>
           <Description ID="R20210518094429553000477">
            <WICNo>Muster-LV/43.1/10.60.0010. -U:2</WICNo>
            <CompleteText>
             <DetailTxt>
              <Text>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bleche auf der Baustelleneinrichtungsfläche für die Entsorgung durch den AG bereitlegen</span>
               </p>
              </Text>
             </DetailTxt>
             <OutlineText>
              <OutlTxt>
               <TextOutlTxt>
                <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                 <span>Entsorgung Bleche</span>
                </p>
               </TextOutlTxt>
              </OutlTxt>
             </OutlineText>
             <!-- GAEB version used: 330 -->
             <!-- GAEB version used: 330 -->
            </CompleteText>
           </Description>
           <QtySpec>Yes</QtySpec>
           <Qty>0.000</Qty>
          </SubDescr>
         </Item>
