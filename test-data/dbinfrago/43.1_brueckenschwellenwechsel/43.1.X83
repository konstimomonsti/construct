            <CompleteText>
             <DetailTxt>
              <Text>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Schiene aufladen, transportieren und abladen, auf Bahnwagen, vom AN beigestellt, im Baustellenbereich, verteilt neben dem Gleis gelagert, Transportweg über 5000 bis 10000 m, am Baustellenlagerplatz.</span>
               </p>
              </Text>
             </DetailTxt>
             <OutlineText>
              <OutlTxt>
               <TextOutlTxt>
