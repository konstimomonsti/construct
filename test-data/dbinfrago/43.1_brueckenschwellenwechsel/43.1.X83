           <WICNo>Muster-LV/43.1/10.20.0010. </WICNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Ausnahmegenehmigung für alle Nachtruhe störende Arbeiten des AN erwirken, einschl. Dokumentation des Einsatzes schallgeschützter Maschinen, einschl. Zusammenführung, Dokumentation und Verarbeitung erforderlicher Informationen des AG, erfüllen behördlicher Auflagen, einschl. Information der Anwohner durch Verteilen und Anbringen von Aushängen und Handzetteln,</span>
               <br/>
               <TextComplement MarkLbl="1" Kind="Owner" ArtChrIdent="23501">
                <ComplCaption>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Menge der herzustellenden und zu verteilenden Handzettel </span>
                </ComplCaption>
                <ComplBodyDec Value="400"/>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;400&#x27;</span>
                </ComplBody>
                <ComplTail>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> St.</span>
                </ComplTail>
               </TextComplement>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Genehmigung Nachtarbeiten</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
          <SumDescr>Yes</SumDescr>
          <SubDescr>
           <SubDNo>1</SubDNo>
           <Description ID="R20210518094408362000287">
            <WICNo>Muster-LV/43.1/10.20.0010. -U:1</WICNo>
            <CompleteText>
             <DetailTxt>
              <Text>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Einschließlich Verteilung von Handzetteln,</span>
               </p>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">gemäß der behördlichen Auflagen bzw.</span>
               </p>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">auf Anordnung des AG an die Anwohner.</span>
               </p>
              </Text>
             </DetailTxt>
             <OutlineText>
              <OutlTxt>
               <TextOutlTxt>
                <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
