           <SubDNo>1</SubDNo>
           <Description ID="R20240410093532982000003">
            <WICNo>Muster-LV/43.1/10.42.0040. -U:1</WICNo>
            <CompleteText>
             <DetailTxt>
              <Text>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bei Aluminotherm-Verbindungsschweißung auf der Brücke, muss die Brückenkonstruktion durch geeignete Maßnahmen z.B. Einschubkästen, Funkenschutz mit feuerfesten Planen, Schweißungsauffangwanne geschütz werden.</span>
               </p>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bei der Ausführung der Verbindungsschweißung darf keine</span>
                <br/>
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Zugfahrt auf der Brücke stattfinden.</span>
               </p>
              </Text>
             </DetailTxt>
             <OutlineText>
              <OutlTxt>
               <TextOutlTxt>
                <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                 <span>Aluminotherm-Verbindungsschweißung auf Brücken</span>
                </p>
               </TextOutlTxt>
              </OutlTxt>
             </OutlineText>
             <!-- GAEB version used: 330 -->
             <!-- GAEB version used: 330 -->
