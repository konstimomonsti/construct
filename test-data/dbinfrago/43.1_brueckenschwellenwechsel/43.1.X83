           </CompleteText>
          </Description>
         </Item>
        </Itemlist>
       </BoQBody>
      </BoQCtgy>
      <BoQCtgy ID="AAAAAAABIPAMMBDA" RNoPart="15">
       <LblTx>
        <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
         <span>Absteckung und Abnahmemessung</span>
        </p>
       </LblTx>
       <BoQBody>
        <Itemlist>
         <Remark ID="AAAAAAABIPAMNDNI">
          <Description ID="R20240321115341829000001">
           <WICNo>Muster-LV/43.1/10.15.</WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Alle erforderlichen Vermessungsarbeiten für die Erstellung des Brückenschwellenhobelplanes und für den Einbau der neuen Brückenschwellen inkl. der Bauabsteckung an der Brücke werden vom AG ausgeführt. Die erforderlichen Absteckbücher für den Einbau der Brückenschwellen werden dem AN digital (PDF) spätestens 5 Tage vor Baubeginn übergeben.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Allgemeine Hinweise zur Vermessung</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Remark>
         <Item ID="AAAAAAABIPAMOJJI" RNoPart="0010">
          <Qty>1.000</Qty>
          <QU>m</QU>
          <Description ID="R20230317072637398000001">
           <WICNo>Muster-LV/43.1/10.15.0010. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Geodätische Abnahme Vermessung - Gleise </span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Durchführung der Geodätischen Abnahmevermessung im Bereich des Gleisumbaus mit den zum Umbau verwendeten Festpunkten und Trassen/Gradienten inkl. Erstellung und Übergabe der Messergebnisse gemäß Ril 883.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Geodätische Abnahme Vermessung - Gleise</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
          <SumDescr>Yes</SumDescr>
          <SubDescr>
           <SubDNo>1</SubDNo>
           <Description ID="R20230317072637406000002">
            <WICNo>Muster-LV/43.1/10.15.0010. -U:1</WICNo>
            <CompleteText>
             <DetailTxt>
              <Text>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Die geodätische Abnahmevermessung muss von einem unabhängigen Vermessungsbüro durchgeführt werden. Das Vermessungsbüro darf nicht die Bauabsteckung durchgeführt haben.</span>
               </p>
              </Text>
             </DetailTxt>
             <OutlineText>
              <OutlTxt>
               <TextOutlTxt>
                <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                 <span>Durchführung geodätische Abnahmevermessung</span>
                </p>
               </TextOutlTxt>
              </OutlTxt>
             </OutlineText>
             <!-- GAEB version used: 330 -->
             <!-- GAEB version used: 330 -->
            </CompleteText>
           </Description>
           <QtySpec>Yes</QtySpec>
           <Qty>0.000</Qty>
          </SubDescr>
         </Item>
         <Item ID="AAAAAAABIPAOBLFI" RNoPart="0020">
          <Qty>1.000</Qty>
          <QU>St</QU>
          <CtlgAssign>
           <CtlgID>AAAAAAABIOKJJEBI</CtlgID>
           <CtlgCode>097</CtlgCode>
          </CtlgAssign>
          <Description ID="R20210518094407745000281">
           <STLBBau>
            <STLBBauCtlg>
             <CtlgName>STLB-Bau</CtlgName>
             <VersDate>2025-10</VersDate>
             <WCtg>097</WCtg>
             <Group>6748</Group>
            </STLBBauCtlg>
            <STLBBauID>
             <ArtChrIdent>2136</ArtChrIdent>
             <ArtChIdx>0</ArtChIdx>
             <ChVIdent>15</ChVIdent>
            </STLBBauID>
            <STLBBauID>
             <ArtChrIdent>9667</ArtChrIdent>
             <ArtChIdx>0</ArtChIdx>
             <ChVIdent>18</ChVIdent>
            </STLBBauID>
            <STLBBauID>
             <ArtChrIdent>10164</ArtChrIdent>
             <ArtChIdx>0</ArtChIdx>
             <ChVIdent>1</ChVIdent>
            </STLBBauID>
           </STLBBau>
           <WICNo>Muster-LV/43.1/10.15.0020. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Aufmessung der im Umbaubereich identifizierten Lichtraumengstelle im Rahmen der Engstellendokumentation mit einem Sicherheitsbereich von +10 cm einschl. der Parameter für die e-Wert-Berechnung gemäß Ril 883.7400.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Lichtraumengstelle aufmessen</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
          <SumDescr>Yes</SumDescr>
          <SubDescr>
           <SubDNo>1</SubDNo>
           <Description ID="R20210518094407882000282">
            <WICNo>Muster-LV/43.1/10.15.0020. -U:1</WICNo>
            <CompleteText>
             <DetailTxt>
              <Text>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Auswertung der erfassten Lichtraumengstelle im Rahmen der Engstellendokumentation einschl. Koordinatenermittlung.</span>
               </p>
              </Text>
             </DetailTxt>
             <OutlineText>
              <OutlTxt>
               <TextOutlTxt>
                <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                 <span>einschließlich Lichtraumengstellenauswertung</span>
                </p>
               </TextOutlTxt>
              </OutlTxt>
             </OutlineText>
             <!-- GAEB version used: 330 -->
             <!-- GAEB version used: 330 -->
            </CompleteText>
           </Description>
           <QtySpec>Yes</QtySpec>
           <Qty>0.000</Qty>
           <QU>----</QU>
          </SubDescr>
         </Item>
         <Item ID="AAAAAAABIPAOFACI" RNoPart="0030">
          <LumpSumItem>Yes</LumpSumItem>
          <Qty>1.000</Qty>
          <QU>psch</QU>
          <Description ID="R20230417073048405000002">
           <WICNo>Muster-LV/43.1/10.15.0030. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Veränderungen der Topographie einmessen und in AVANI im Abbildungssystem DB R EF einarbeiten ( AVANI - Job) ,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Ausführung durch präqualifiziertes Ingenieurbüros mit AVANI Zugang. Einmessung gemäß Ril 883.7100.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
