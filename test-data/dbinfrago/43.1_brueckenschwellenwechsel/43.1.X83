           <WICNo>Muster-LV/43.1/10.70.0150. </WICNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Gebrauchsüberlassung für flächenorientiertes Hängegerüst, DIN EN 12810-1, als Arbeitsgerüst DIN EN 12811-1,</span>
               <br/>
               <TextComplement MarkLbl="1" Kind="Owner" ArtChrIdent="-6498">
                <ComplCaption>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Positionsmenge = Produkt aus </span>
                </ComplCaption>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;...........1.........................................&#x27;</span>
                </ComplBody>
                <ComplTail>
                 <br/>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">(Gebrauchsüberlassungsmenge)</span>
                </ComplTail>
               </TextComplement>
               <br/>
               <TextComplement MarkLbl="2" Kind="Owner" ArtChrIdent="-6497">
                <ComplCaption>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">mal </span>
                </ComplCaption>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;............1........................................&#x27;</span>
                </ComplBody>
                <ComplTail>
                 <br/>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">(Gebrauchsüberlassungsdauer)</span>
                </ComplTail>
               </TextComplement>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Lastklasse 3 (2 kN/m2), mit einer Gerüstlage, Höhenklasse H 1, Einrüstung für Montagearbeiten, Grundfläche rechteckig, direkt belastbar,</span>
               <br/>
