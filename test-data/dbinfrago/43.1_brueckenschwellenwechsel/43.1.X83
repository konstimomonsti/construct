         <Item ID="AAAAAAABIPCKCECI" RNoPart="0060">
          <Qty>1.000</Qty>
          <QU>St</QU>
          <CtlgAssign>
           <CtlgID>AAAAAAABIOKJJEBI</CtlgID>
           <CtlgCode>000</CtlgCode>
          </CtlgAssign>
          <Description ID="R20210518094433528000511">
           <WICNo>Muster-LV/43.1/10.80.0060. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Schutzhaltsignal (Sh2) als Tages- und Nachtzeichen</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">auf- und abbauen, einschließlich An- und Abtransport,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">ggf. umsetzen bzw. temporäre Herstellung der</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Profilfreiheit, vorhalten, betreiben,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">ggf. außer- und wieder in Betrieb setzen.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Einschl. Betriebsstoffe und Energieversorgung.</span>
               <br/>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Umfang der Signalisierungsmaßnahme:</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Signalisierung aller für die Durchführung der</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Baumaßnahme gesperrten Gleise, während der zeitlichen</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Vorgaben, in denen Gleissperrungen erforderlich sind.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Signalisierung: Sh2-Signale</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIPCKEEDI" RNoPart="0070">
          <Qty>1.000</Qty>
          <QU>St</QU>
          <CtlgAssign>
           <CtlgID>AAAAAAABIOKJJEBI</CtlgID>
           <CtlgCode>000</CtlgCode>
          </CtlgAssign>
          <Description ID="R20210518094433711000512">
           <WICNo>Muster-LV/43.1/10.80.0070. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Langsamfahrsignale Lf 1 und Lf 2/3, ggf. m.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Richtungspfeil,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">als Tages- und Nachtzeichen auf- und abbauen,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">einschließlich An- und Abtransport, ggf. umsetzen,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">vorhalten,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">betreiben, ggf. anpassen an wechselnde</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Geschwindigkeiten</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">bzw. Herstellung der Gültig- bzw. Ungültigkeit.</span>
               <br/>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Umfang der Signalisierungsmaßnahme:</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Signalisierung aller für die Durchführung der</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Baumaßnahme erforderlichen Langsamfahrstellen, während</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">der zeitlichen Vorgaben, in denen Langsamfahrstellen</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">erforderlich sind.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Signalisierung: Lf-Signale</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIPCKGEPA" RNoPart="0080">
          <Qty>1.000</Qty>
          <QU>St</QU>
          <CtlgAssign>
           <CtlgID>AAAAAAABIOKJJEBI</CtlgID>
           <CtlgCode>000</CtlgCode>
          </CtlgAssign>
          <Description ID="R20210518094433873000513">
           <WICNo>Muster-LV/43.1/10.80.0080. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Signal EL 6 &#x22;Halt für Fahrzeuge mit gehobenem</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Stromabnehmer&#x22;, rückstrahlend, auf- und abbauen,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">einschließlich An- und Abtransport, ggf. umsetzen,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">vorhalten,</span>
               <br/>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Umfang der Signalisierungsmaßnahme:</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Signalisierung aller für die Durchführung der</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Baumaßnahme erforderlichen Standorte, während</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">der zeitlichen Vorgaben, in denen die Signalisierung</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">erforderlich ist.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Signalisierung: Signal El 6</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIPCKIEKI" RNoPart="0090">
          <Qty>1.000</Qty>
          <QU>St</QU>
          <CtlgAssign>
           <CtlgID>AAAAAAABIOKJJEBI</CtlgID>
           <CtlgCode>000</CtlgCode>
          </CtlgAssign>
          <Description ID="R20210518094434040000514">
           <WICNo>Muster-LV/43.1/10.80.0090. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Baugleismagnet(e) 500 Hz oder 1000 Hz, für</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">vorübergehende</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Langsamfahrstelle entsprechend Ril 892.9107A02 einbauen</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">und in Betrieb nehmen, bei Aufhebung der</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">vorübergehenden</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Langsamfahrstelle ausbauen und außer Betrieb nehmen,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">ggf. bei zeitweiliger Aufhebung der Langsamfahrstelle</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">ausbauen, damit außer Betrieb nehmen, und wieder</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">einbauen, damit wieder in Betrieb nehmen,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">ggf. umsetzen.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Inkl. An-/Abtransport der vom/zum Lagerort des AG.</span>
               <br/>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Umfang der Maßnahme:</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Absicherung aller für die Durchführung der Baumaßnahme</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">erforderlichen Langsamfahrstellen,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">während der zeitlichen Vorgaben, in denen</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Langsamfahrstellen erforderlich sind.</span>
               <br/>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Signalisierung: Gleismagnet(e) des AG</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIPCKKFDI" RNoPart="0100">
          <Qty>1.000</Qty>
          <QU>St</QU>
          <CtlgAssign>
           <CtlgID>AAAAAAABIOKJJEBI</CtlgID>
           <CtlgCode>000</CtlgCode>
          </CtlgAssign>
          <Description ID="R20210518094434211000515">
           <WICNo>Muster-LV/43.1/10.80.0100. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Baugleismagnet(e) 500 Hz oder 1000 Hz, für</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">vorübergehende</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Langsamfahrstelle entsprechend Ril 892.9107A02 einbauen</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">und in Betrieb nehmen, bei Aufhebung der</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">vorübergehenden</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Langsamfahrstelle ausbauen und außer Betrieb nehmen</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">ggf. bei zeitweiliger Aufhebung der Langsamfahrstelle</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">ausbauen, damit außer Betrieb nehmen, und wieder</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">einbauen, damit wieder in Betrieb nehmen,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">ggf. umsetzen,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Gleismagnet(e) am Einbauort bereitstellen und nach dem</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Ausbauen vom Einbauort entfernen.</span>
               <br/>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Umfang der Maßnahme:</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Absicherung aller für die Durchführung der Baumaßnahme</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">erforderlichen Langsamfahrstellen,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">während der zeitlichen Vorgaben, in denen</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Langsamfahrstellen erforderlich sind.</span>
               <br/>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Signalisierung: Gleismagnet(e) des AN</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
