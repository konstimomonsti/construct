             <ChVIdent>15</ChVIdent>
             <OutlTextPart>Yes</OutlTextPart>
            </STLBBauID>
            <STLBBauID>
             <ArtChrIdent>15152</ArtChrIdent>
             <ArtChIdx>0</ArtChIdx>
             <ChVIdent>8</ChVIdent>
            </STLBBauID>
            <STLBBauID>
             <ArtChrIdent>23501</ArtChrIdent>
             <ArtChIdx>0</ArtChIdx>
