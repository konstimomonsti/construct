             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Gleis heben Bettung verdichten 1.Stabil. Verschieb. 2.Stabil. Verschieb.</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
