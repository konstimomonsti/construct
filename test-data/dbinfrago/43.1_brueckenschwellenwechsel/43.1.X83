             <ArtChrIdent>2136</ArtChrIdent>
             <ArtChIdx>0</ArtChIdx>
             <ChVIdent>15</ChVIdent>
            </STLBBauID>
            <STLBBauID>
             <ArtChrIdent>20099</ArtChrIdent>
             <ArtChIdx>0</ArtChIdx>
             <ChVIdent>1</ChVIdent>
            </STLBBauID>
            <STLBBauID>
             <ArtChrIdent>24743</ArtChrIdent>
             <ArtChIdx>0</ArtChIdx>
             <ChVIdent>2</ChVIdent>
            </STLBBauID>
           </STLBBau>
           <WICNo>Muster-LV/43.1/10.60.0080. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Brückenbalken/-schwelle einbauen, vor Kopf, aus Holz, Länge 2600 mm, Breite 240 mm, Höhe 300 mm, nach Bearbeitungsplan AG bearbeiten, Schwellenbänder an Kopfenden anbringen, Bohrlöcher herstellen, Brückenbalken auf Brückenhauptträger aufsetzen, Schienenauflager für Schienenform 60, Schienenauflager bestehend aus Schraube M 22 x 100, Güte: 5.6, DIN EN ISO 4017, DB Mutter M 22 mit Fe 31, Höhenausgleichsplatten ECF, elastischen Zwischenplatten Zwp 194a/b 150, ECF Rippenplatten Erp 1a/b einschl. Schienenbefestigung, Isolierhülsen Fbu, Zwischenlage Zw, Führungsschienenauflager mit Befestigungsplatte für Schienenform 60, Brückenbalken/Brückenschwelle mit M24, 2 Muttern, 2 Unterlegscheiben und einem Federring befestigen, Auflager auf Brückenlängsträger einschl. EVA Grundplatte, Schwellenschuh und EVA Höhenzwischenplatte, Stoffe stellt AG, Unterseite des Brückenbalkens/-schwelle bei Auflagerung auf Nietköpfen oder Versteifungen örtlich ausfräsen.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Brückenbalken einbauen L 2600mm B 240mm H 300mm</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
          <SumDescr>Yes</SumDescr>
          <SubDescr>
           <SubDNo>1</SubDNo>
           <Description ID="R20240409141115288000019">
            <WICNo>Muster-LV/43.1/10.60.0080. -U:1</WICNo>
            <CompleteText>
             <DetailTxt>
              <Text>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Neue Brückenschwellen aufnehmen, zum Einbauort</span>
                <br/>
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">transportieren und im Zuge des Rückbaues der alten</span>
                <br/>
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Brückenschwellen nach dem Brückenbalkenverzeichnis</span>
                <br/>
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">verlegen, in Höhe und Richtung gemäß Absteckbuch  ausrichten und montieren, Bohrlöcher für Bolzenbefestigung der Brückenschwellen und Bohrungen für Rippenplatten auf den Schwellen herstellen (mind. 14 Bohrungen pro Schwelle).                                                      Der AN muss die Bohrspänne abzusaugen, in wasserdichte Säcke verpacken und nach der gesetzlichen Bestimmung entsorgen,Verschrauben der neuen Brückenschwellen mit einem Drehmoment von 150 Nm an den Befestigungspunkten mit jeweils 2 Bolzen (M 20 bis M 26) mit Beilagscheiben und</span>
                <br/>
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">selbstsichernder Muttern, Rippenplatten auf dem Brückenbalken befestigen (für Fahr- und Führungsschienen) mit einem Drehmoment von 220 Nm.</span>
               </p>
              </Text>
             </DetailTxt>
             <OutlineText>
              <OutlTxt>
               <TextOutlTxt>
                <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                 <span>Einbau Brückenbalken auf der Konstruktion</span>
                </p>
               </TextOutlTxt>
              </OutlTxt>
             </OutlineText>
             <!-- GAEB version used: 330 -->
             <!-- GAEB version used: 330 -->
            </CompleteText>
           </Description>
           <QtySpec>Yes</QtySpec>
           <Qty>0.000</Qty>
          </SubDescr>
          <SubDescr>
           <SubDNo>2</SubDNo>
           <Description ID="R20240409142408447000020">
            <WICNo>Muster-LV/43.1/10.60.0080. -U:2</WICNo>
            <CompleteText>
             <DetailTxt>
              <Text>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Anpassung der eingelegten Brückenschwellen durch ausbohren der Kostruktionsnieten an der Unterseite der Brückenschwellen mit Rundfräsern. Lamellenwechsel oder Konstruktionsunebenheiten die bei der Vermessung nicht aufgenommen werden konnten , müssen ebenfalls an der Unterseite der Brückenschwelle ausgearbeitet werden. </span>
               </p>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Die Brückenschwelle muss in Lage und Höhe gemäß dem Brückenschwellenverzeichnisses komplett auf der Konstruktion bzw. dem Auflager aufliegen.</span>
               </p>
              </Text>
             </DetailTxt>
             <OutlineText>
              <OutlTxt>
               <TextOutlTxt>
                <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                 <span>Anpassung der Brückenbalken</span>
                </p>
               </TextOutlTxt>
              </OutlTxt>
             </OutlineText>
             <!-- GAEB version used: 330 -->
             <!-- GAEB version used: 330 -->
            </CompleteText>
           </Description>
           <QtySpec>Yes</QtySpec>
           <Qty>0.000</Qty>
          </SubDescr>
         </Item>
         <Item ID="AAAAAAABIPBKICKI" RNoPart="0090">
          <Qty>1.000</Qty>
          <QU>St</QU>
          <CtlgAssign>
           <CtlgID>AAAAAAABIOKJJEBI</CtlgID>
           <CtlgCode>097</CtlgCode>
          </CtlgAssign>
          <Description ID="R20240411134605384000015">
           <WICNo>Muster-LV/43.1/10.60.0090. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Rippenplatte auf Brückenbalken/-schwelle montieren, komplett einschl. Schwellenschrauben und Federringen, für Fahrschiene und Schutzschiene,Schraubenlöcher bohren, Anzahl 5 pro Rippenplatte.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Rippenplatte montieren Fahrschiene Schutzschiene</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
