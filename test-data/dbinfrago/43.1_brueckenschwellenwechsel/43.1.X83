           <WICNo>Muster-LV/43.1/10.40.0050. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Schiene von den Schwellen lösen und aufnehmen, im direkten Zusammenhang mit den Umbauarbeiten, Schienen zum Verschrotten trennen, Kleineisenteile sammeln, sortieren und versandfertig verladen, Hebe- und Fahrzeuge stellt der AN.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Schiene lösen aufnehmen</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
