   <BoQInfo>
    <Name>43.1</Name>
    <LblBoQ>Brückenschwellenwechsel ohne Lieferung /Entsorgung AN Stand 03.2026</LblBoQ>
    <Date>2026-03-24</Date>
    <OutlCompl>AllTxt</OutlCompl>
    <BoQBkdn>
     <Type>BoQLevel</Type>
     <LblBoQBkdn>Bereich</LblBoQBkdn>
