           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Baugelände abräumen, von Aufwuchs, Bewuchshöhe über 200 bis 300 cm, Schnittstelle auf Höhe der Geländeoberfläche, Schlagabraum häckseln und auf dem Baugelände verteilen.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Baugelände abräumen Aufwuchs H 200-300cm</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
