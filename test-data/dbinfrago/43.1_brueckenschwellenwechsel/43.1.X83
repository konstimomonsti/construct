          </Description>
         </Item>
         <Item ID="AAAAAAABIPAMJOKI" RNoPart="0040">
          <LumpSumItem>Yes</LumpSumItem>
          <Qty>1.000</Qty>
          <QU>psch</QU>
          <CtlgAssign>
           <CtlgID>AAAAAAABIOKJJEBI</CtlgID>
           <CtlgCode>097</CtlgCode>
          </CtlgAssign>
          <Description ID="R20210518094407086000277">
           <WICNo>Muster-LV/43.1/10.10.0040. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Zulage Baustellenlogistik Transportentfernung 200 km bis 300 km</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Zulage für nichtschienengebundene Logistikleistungen / Transportleistung für die Baustellenversorgung - Baustellenbelieferung mit Neustoffen, gestellt durch den AG aus der Schwellenfertigung Standort Nürnberg / Standort Schwandorf</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Für die Kilometerbestimmung zählt die einfache Entfernung zwischen Standort Nürnberg / Standort Schwandorf und der Baustelleneinrichtungsfläche </span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Zulage Baustellenlogistik Transportentfernung 200 km bis 300 km</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
