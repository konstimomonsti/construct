                <span>Zulage Baustellenlogistik Transportentfernung bis 100 km</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIPAMHPCI" RNoPart="0030">
