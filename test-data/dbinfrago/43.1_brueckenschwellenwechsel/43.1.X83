            <CompleteText>
             <DetailTxt>
              <Text>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Zulässige mineralische Ersatzbaustoffe gemäß EBV Anlage 2 - Ausgleichsschicht </span>
               </p>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Neustoffe, Ersatzbaustoffe nicht zulässig</span>
               </p>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <br/>
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bodenmaterial der Klassen 0 (BM-0), F0 (BM-F0) , Baggergut der Klassen 0 (BG-0), F0 (BG-F0); Gleisschotter der Klasse 0 (GS-0)</span>
                <br/>
