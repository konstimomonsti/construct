               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Gleismagnet des AN, vorhalten MLV-SLE_03010180</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABILFDDIGA" RNoPart="0190">
          <Qty>1.000</Qty>
          <QU>St</QU>
          <Description>
           <WICNo>DB Netz/60/03.01.0190. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Wärtervorsignal / Wärtervorsignalwiederholer (Vr 0)</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">gem. RZ S 504.03.01 als nicht ortsfestes Tages-</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">oder Nachtzeichen für die Ankündigung des</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Schutzhaltsignals (Sh 2), neben dem Gleis gem.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">RZ S504.5.1 auf- und abbauen,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">einschließlich An- und Abtransport.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Wärtervorsignal (Vr 0), auf- und abbauen MLV-SLE_03010190</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
           </CompleteText>
          </Description>
         </Item>
