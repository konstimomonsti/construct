           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Signal Lf 2 (ggf. mit Richtungspfeil/Zuordnungstafel)</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">oder Lf 3, nach Ril 301 bei vorzeitigem Ende der</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Langsamfahrstelle außer/wieder in Betrieb setzen/nehmen</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">(bedecken/Bedeckung entfernen).</span>
              </p>
             </Text>
