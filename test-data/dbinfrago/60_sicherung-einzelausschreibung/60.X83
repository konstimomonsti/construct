            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Prüfung der ATWS-Planung auf gesonderte schriftliche</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Anordnung der für den Bahnbetrieb zuständige Stelle</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">(BzS) durchführen,</span>
              </p>
             </Text>
             <TextComplement MarkLbl="61" Kind="Owner">
              <ComplCaption>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">ATWS der Pos.</span>
              </ComplCaption>
              <ComplBody>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27; &#x27;</span>
              </ComplBody>
