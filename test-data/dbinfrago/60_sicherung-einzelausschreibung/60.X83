             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Signal Lf 2 o. Lf 3, außer/in Betrieb setzen MLV-SLE_03010150</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABILFHOBJA" RNoPart="0160">
          <Qty>1.000</Qty>
          <QU>St</QU>
          <Description>
           <WICNo>DB Netz/60/03.01.0160. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Baugleismagnet 500 Hz oder 1000 Hz, für vorübergehende</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Langsamfahrstelle entsprechend Ril 892.9107A02 einbauen</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">und in Betrieb nehmen,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">bei Aufhebung der vorübergehenden Langsamfahrstelle</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">ausbauen und außer Betrieb nehmen.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Gleismagnet ein- und ausbauen MLV-SLE_03010160</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABILFDAAAA" RNoPart="0170">
          <Qty>1.000</Qty>
          <QU>St</QU>
          <Description>
           <WICNo>DB Netz/60/03.01.0170. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Baugleismagnet des AN, 500 Hz oder 1000 Hz für</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">vorübergehende Langsamfahrstelle der</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Kennziffer 0,5 bis 7 (Ril 819.1310A01),</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">geprüft entsprechend Ril 892.9307A01 in Verbinung</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">mit Ril 892.9107A02,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">am Einbauort bereitstellen und nach dem Ausbauen vom</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Einbauort entfernen.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Gleismagnet des AN, bereitstellen MLV-SLE_03010170</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABILFDBLHI" RNoPart="0180">
          <Qty>1.000</Qty>
          <QU>d</QU>
          <Description>
