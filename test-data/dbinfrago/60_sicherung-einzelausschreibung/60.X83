         </Item>
         <Item ID="AAAAAAABILEOAAAA" RNoPart="0020">
          <Qty>1.000</Qty>
          <QU>St</QU>
          <Description>
           <WICNo>DB Netz/60/02.05.0020. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Ankündigungsanlage AKA L90 aufbauen und abbauen.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Ankündigungsanlage auf- u. abbauen, AKA L90 MLV-SLE_02050020</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABILEOBLOI" RNoPart="0030">
          <Qty>1.000</Qty>
          <QU>h</QU>
          <Description>
           <WICNo>DB Netz/60/02.05.0030. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Ankündigungsanlage AKA L90 bedienen.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
