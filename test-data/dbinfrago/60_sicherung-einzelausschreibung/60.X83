    </BoQCtgy>
    <BoQCtgy ID="AAAAAAABILEKAAAA" RNoPart="03">
     <LblTx>
      <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
       <span>Bauaffine Dienstleistungen</span>
      </p>
     </LblTx>
     <BoQBody>
      <BoQCtgy ID="AAAAAAABILEKBGHA" RNoPart="01">
       <LblTx>
        <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
         <span>Signalisierung</span>
        </p>
       </LblTx>
       <BoQBody>
        <Itemlist>
         <Item ID="AAAAAAABILEKCMAI" RNoPart="0010">
          <Qty>1.000</Qty>
          <QU>St</QU>
          <Description>
           <WICNo>DB Netz/60/03.01.0010. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Schutzhaltsignal (Sh 2) als Tages- oder Nachtzeichen,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">auf- und abbauen, im Zusammenhang mit der</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">dazugehörenden Sicherungsmaßnahme/bauaffienen Dienstleistung,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">als Tages- oder Nachtzeichen, einschließlich An- und</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Abtransport.</span>
               <br/>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Schutzhaltsignal (Sh2), auf-/abbauen MLV-SLE_03010010</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABILEKEJII" RNoPart="0020">
          <Qty>1.000</Qty>
          <QU>d</QU>
          <Description>
           <WICNo>DB Netz/60/03.01.0020. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Schutzhaltsignal (Sh 2) vorhalten und betreiben, als</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Tages- oder Nachtzeichen, einschließlich</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Betriebsstoffe/Energieversorgung,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">(Abrechnung:</span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Summe von Stück Sh 2-Sig. x Anzahl Tage = (d)).</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Schutzhaltsignal (Sh 2), vorhalten und betreiben MLV-SLE_03010020</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABILEKGGHI" RNoPart="0030">
          <Qty>1.000</Qty>
          <QU>St</QU>
          <Description>
           <WICNo>DB Netz/60/03.01.0030. </WICNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Schutzhaltsignal (Sh 2) umsetzen, im Zusammenhang mit</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">der Sicherungsmaßnahme,</span>
              </p>
             </Text>
             <TextComplement MarkLbl="61" Kind="Owner">
              <ComplCaption>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Baustellentransport bis </span>
              </ComplCaption>
              <ComplBody>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27; &#x27;</span>
              </ComplBody>
              <ComplTail>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> m.</span>
              </ComplTail>
             </TextComplement>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;"/>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Schutzhaltsignal (Sh 2), umsetzen MLV-SLE_03010030</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABILEKIDEA" RNoPart="0040">
          <Qty>1.000</Qty>
          <QU>St</QU>
          <Description>
           <WICNo>DB Netz/60/03.01.0040. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Schutzhaltsignal (Sh 2) als Tages- oder Nachtzeichen,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">bei nicht ständiger örtlicher Anwesenheit,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">außer/wieder in Betrieb setzen/nehmen.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Schutzhaltsignal (Sh 2), außer/in Betrieb setzen MLV-SLE_03010040</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABILEKJPPI" RNoPart="0050">
          <Qty>1.000</Qty>
          <QU>St</QU>
          <Description>
           <WICNo>DB Netz/60/03.01.0050. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Einen Satz Langsamfahrsignale bestehend aus :</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Lf 1 (ggf. mit Richtungspfeil/Zuordnungstafel),</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Lf 2 (ggf. mit Richtungspfeil/Zuordnungstafel)</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">und Lf 3, rückstrahlend, als Tages- oder Nachtzeichen,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">auf- und abbauen, einschließlich An- und Abtransport.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Langsamfahrsignale (Satz) auf-/abbauen MLV-SLE_03010050</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABILEKLNAA" RNoPart="0060">
          <Qty>1.000</Qty>
          <QU>d</QU>
          <Description>
           <WICNo>DB Netz/60/03.01.0060. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Einen Satz Langsamfahrsignale bestehend aus :</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Lf 1 (ggf. mit Richtungspfeil/Zuordnungstafel),</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Lf 2 (ggf. mit Richtungspfeil/Zuordnungstafel)</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">und Lf 3, rückstrahlend, als Tages- oder Nachtzeichen,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">vorhalten und betreiben,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">(Abrechnung:</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Summe von Satz Lf-Sig. Stück X Anzahl Tage = (d)).</span>
              </p>
