      <BoQCtgy ID="AAAAAAABILEJLLCA" RNoPart="02">
       <LblTx>
        <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
         <span>Sicherungspersonale</span>
        </p>
       </LblTx>
       <BoQBody>
        <Itemlist>
         <Remark ID="AAAAAAABILEJNAFA">
          <Description>
           <WICNo>DB Netz/60/01.02.</WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Zu dem  weiteren Sicherungspersonal sind die Funktionen </span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Sicherungs-, Absperr-, Überwachungsposten zugeordnet.</span>
               <br/>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Der Einsatz Sicherungsposten erfolgt auch zur Überwachung des Seitenläufers im Mittelkern an einer</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Gleisbau-Großmaschine entsprechend der Vorbemerkungen.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt/>
             </OutlTxt>
            </OutlineText>
           </CompleteText>
          </Description>
         </Remark>
         <Item ID="AAAAAAABILEJOEGI" RNoPart="0010">
          <Qty>1.000</Qty>
          <QU>h</QU>
          <Description>
           <WICNo>DB Netz/60/01.02.0010. </WICNo>
           <CompleteText>
