  <BoQ ID="AAAAAAABIBMKAAAA">
   <BoQInfo>
    <Name>30</Name>
    <LblBoQ>Lärmschutzwände Muster-LV_V03/2023</LblBoQ>
    <Date>2023-04-03</Date>
    <OutlCompl>AllTxt</OutlCompl>
    <BoQBkdn>
     <Type>BoQLevel</Type>
     <LblBoQBkdn>LV-Gruppe 1</LblBoQBkdn>
     <Length>2</Length>
     <Num>Yes</Num>
    </BoQBkdn>
    <BoQBkdn>
     <Type>BoQLevel</Type>
     <LblBoQBkdn>LV-Gruppe 2</LblBoQBkdn>
     <Length>2</Length>
     <Num>Yes</Num>
    </BoQBkdn>
