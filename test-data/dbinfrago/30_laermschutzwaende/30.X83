              <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">, feuerverzinkt</span>
              <br/>
              <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">und beschichtet, Wandhöhe bis </span>
             </Text>
