         <Item ID="AAAAAAABICBPMBMI" RNoPart="0030">
          <Qty>0.000</Qty>
          <QU>m2</QU>
          <Description>
           <WICNo>DB Netz/30/01.06.0030. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Zulage zu vorgenannten Sockelelementen für</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Sonderformen wie z. B. Ausklingungen im</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Anschlussbereich an BW, Trapezformen für LSW-Nischen</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">im Bereich von Böschungen etc. Entwässerungsöffnungen</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">und Kleintierdurchlässe werden nicht über diese</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Position, sondern gesondert abgerechnet.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Zulage zu Sockelelementen für Sonderformen MLV-LSW 01060030</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
