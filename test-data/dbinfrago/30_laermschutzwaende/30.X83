              <ComplCaption/>
              <ComplBody>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;1,60 m&#x3c;)&#x27;</span>
              </ComplBody>
              <ComplTail/>
             </TextComplement>
             <Text>
              <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> lang, Breite wie Treppenanlage, </span>
              <br/>
              <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Maschenteilung </span>
             </Text>
