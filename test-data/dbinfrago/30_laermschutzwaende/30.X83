               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;8x8 mm oder geschlossen &#x3c;)&#x27;</span>
              </ComplBody>
              <ComplTail/>
             </TextComplement>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Oberfläche besandet mit schwarzer geschlossener Antrittskante, Rutschsicherheit R13,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">inclusive GFK-Konstruktionsprofilen, Vegetationsschutzplane / Unkrautvlies, Geländer und Gründung mit Schraubfundamenten wie vor beschrieben.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Zulage zur Rettungstreppe als GFK-Konstruktion für durchlaufendes Zwischenpodest MLV-LSW 01100180</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
           </CompleteText>
          </Description>
