               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;über X,XX bis X,XX m&#x3c;)&#x27;</span>
              </ComplBody>
              <ComplTail/>
             </TextComplement>
             <Text>
              <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> lang, Durchmesser und Wandstärke = 1016 *</span>
             </Text>
             <TextComplement MarkLbl="62" Kind="Owner">
              <ComplCaption/>
              <ComplBody>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;X,X &#x3c;)&#x27;</span>
              </ComplBody>
              <ComplTail/>
             </TextComplement>
             <Text>
              <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">mm, Material = Stahl</span>
