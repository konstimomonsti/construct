          <Qty>0.000</Qty>
          <QU>m2</QU>
          <Description>
           <WICNo>DB Netz/30/01.06.0130. </WICNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Zulage zu vorgenannten Beton-Lärmschutz-Elementen für</span>
              <br/>
              <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">bahnseitige Durchfärbung der Absorberkörper.</span>
              <br/>
              <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Durchfärbung mindestens </span>
             </Text>
             <TextComplement MarkLbl="61" Kind="Owner">
              <ComplCaption/>
              <ComplBody>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;4%&#x3c;)&#x27;</span>
              </ComplBody>
              <ComplTail/>
             </TextComplement>
             <Text>
              <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> mit bis zu</span>
             </Text>
             <TextComplement MarkLbl="62" Kind="Owner">
              <ComplCaption/>
              <ComplBody>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;3&#x3c;)&#x27;</span>
              </ComplBody>
              <ComplTail/>
             </TextComplement>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> Farben nach Abstimmung mit dem AG, an</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">RAL-Palette angelehnt. Abstimmung erfolgt durch</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bemusterung, die entsprechenden Aufwendungen sind</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">einzurechnen und werden nicht gesondert vergütet.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
