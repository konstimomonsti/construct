         <Item ID="AAAAAAABICBIBPII" RNoPart="0240">
          <Qty>0.000</Qty>
          <QU>St</QU>
          <Description>
           <WICNo>DB Netz/30/01.03.0240. </WICNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">bestehende Rammrohre aus Stahl </span>
             </Text>
             <TextComplement MarkLbl="61" Kind="Owner">
              <ComplCaption/>
              <ComplBody>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;da sonstige, projektspezifisch anzugeben * 6,3 / 7,1 / 8&#x3c;)&#x27;</span>
              </ComplBody>
              <ComplTail/>
             </TextComplement>
             <Text>
              <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> mm bis </span>
             </Text>
             <TextComplement MarkLbl="62" Kind="Owner">
              <ComplCaption/>
              <ComplBody>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;1,00m unter Schienenoberkante&#x3c;)&#x27;</span>
              </ComplBody>
              <ComplTail/>
             </TextComplement>
             <Text>
              <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> zurückbauen.</span>
              <br/>
              <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Die notwendigen Erdarbeiten sind einzurechnen und werden nicht gesondert vergütet, ggfs. notwendige Verbauarbeiten werden gesondert vergütet. Aushub</span>
             </Text>
             <TextComplement MarkLbl="63" Kind="Owner">
              <ComplCaption/>
              <ComplBody>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;seitlich lagern und wieder verfüllen und verdichten / aufnehmen, auf Zwischenlager transportieren und lagern&#x3c;)&#x27;</span>
              </ComplBody>
              <ComplTail/>
             </TextComplement>
             <Text>
              <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">. </span>
              <br/>
              <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Der zurückzubauende Rammrohrkopf ist ausbetoniert </span>
             </Text>
             <TextComplement MarkLbl="64" Kind="Owner">
              <ComplCaption/>
              <ComplBody>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;mit / ohne konstruktiver Bewehrung&#x3c;)&#x27;</span>
              </ComplBody>
              <ComplTail/>
