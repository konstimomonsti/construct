            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Torsionsbalken als Stahlbetonkonstruktion rückbauen MLV-LSW 01030460</span>
