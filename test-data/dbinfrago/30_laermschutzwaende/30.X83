            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Wandsockel gemäß RIZ-A-LSW aus bewehrtem Beton für</span>
              <br/>
