          <Description>
           <WICNo>DB Netz/30/01.06.0020. </WICNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Zulage zu vorgenannten Sockel-Elementen für</span>
              <br/>
              <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Durchfärbung. Durchfärbung mindestens </span>
             </Text>
             <TextComplement MarkLbl="61" Kind="Owner">
              <ComplCaption/>
              <ComplBody>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;4%&#x3c;)&#x27;</span>
              </ComplBody>
