          <Qty>0.000</Qty>
          <QU>h</QU>
          <Description>
           <WICNo>DB Netz/30/01.03.0080. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Wasserhaltungsanlage nach besonderer Abstimmung mit AG</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">über längere Dauer betreiben, überwachen und</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">unterhalten. Abrechnung erfolgt nach</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Betriebsstundenzähler.</span>
              </p>
