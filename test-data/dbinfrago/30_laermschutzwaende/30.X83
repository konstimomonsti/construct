         </Item>
         <Item ID="AAAAAAABICCACNAA" RNoPart="0150">
          <Qty>0.000</Qty>
          <QU>m3</QU>
          <Description>
           <WICNo>DB Netz/30/01.05.0150. </WICNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Aussparung im vorgenannten Köcher für den</span>
              <br/>
              <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Pfostenanschluss mit unbewehrten Beton </span>
             </Text>
             <TextComplement MarkLbl="61" Kind="Owner">
              <ComplCaption/>
              <ComplBody>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;C25/30&#x3c;)&#x27;</span>
              </ComplBody>
              <ComplTail/>
             </TextComplement>
             <Text>
              <br/>
              <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">ohne Erstarrungs- bzw. Beschleunigungsmittel,</span>
              <br/>
              <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Expositionsklasse </span>
             </Text>
             <TextComplement MarkLbl="62" Kind="Owner">
              <ComplCaption/>
              <ComplBody>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;XC2, XF1, Anforderungsklasse D, WF&#x3c;)&#x27;</span>
              </ComplBody>
              <ComplTail/>
             </TextComplement>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);"> verfüllen. Reinigung der Aussparung von Dreck,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">losen Bestandteilen, Wasser o.ä. Die obere Fläche des</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Gründungskörpers ist mit einem allseitigen Gefälle von</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">min. 5 % vom Pfosten- zum Köcherrand herzustellen.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Betonage gleichzeitig mit dem Einsetzen des Pfostens</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">der LSW, einschl. erforderlicher Montage- und</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Unterkonstruktion einschl. aller Befestigungs- und</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Verbindungsmittel. Einschl. Dichtungsanstrich aus</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bitumen (3 x kalt).</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Verfüllung Köcher MLV-LSW 01050150</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
           </CompleteText>
          </Description>
