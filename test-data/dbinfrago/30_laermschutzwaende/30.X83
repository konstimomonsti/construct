          <Description>
           <WICNo>DB Netz/30/01.06.0090. </WICNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Zulage für alle Alu-LSW-Elemente für die</span>
              <br/>
              <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Farbgestaltung mit mehr als 3 RAL-Farben. Die</span>
              <br/>
              <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Lärmschutzwände sind im Rahmen der Ausführungsplanung</span>
              <br/>
              <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">in Abstimmung mit dem AG mit insgesamt </span>
             </Text>
             <TextComplement MarkLbl="61" Kind="Owner">
              <ComplCaption/>
              <ComplBody>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;5&#x3c;)&#x27;</span>
              </ComplBody>
              <ComplTail/>
             </TextComplement>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">RAL-Farben zu gestalten.</span>
              </p>
             </Text>
            </DetailTxt>
