         <Item ID="AAAAAAABICBEHKBI" RNoPart="0271">
          <Qty>0.000</Qty>
          <QU>St</QU>
          <Description>
           <WICNo>DB Netz/30/01.03.0271. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
