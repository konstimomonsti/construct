              <ComplBody>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;(&#x3e;Geländer mit Zwischenholm ODER Füllstabgeländer MIT/OHNE Fußleiste&#x3c;)&#x27;</span>
              </ComplBody>
              <ComplTail/>
             </TextComplement>
             <Text>
              <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">,</span>
              <br/>
              <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bauhöhe ca. </span>
