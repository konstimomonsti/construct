            <CompleteText>
             <ComplTSB>Yes</ComplTSB>
             <DetailTxt>
              <Text>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bau- und Abbruchabfälle, Holz, Glas und Kunststoff,</span>
                <br/>
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">nicht gefährlich, Abfallschlüssel nach AVV (Abfallverzeichnis-Verordnung) 170201 Bau-/Abbruchabfall Holz,</span>
                <br/>
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">schadstoffbelastet, Altholzkategorie A I, Schadstoff Antimon,</span>
                <br/>
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">auf Baustelle lagernd, laden, mit LKW des AN transportieren, entsorgen, max. Gesamtgewicht ohne Beschränkung, zum zugelassenem Lager oder zur Anlage nach Wahl des AN,</span>
                <br/>
                <TextComplement MarkLbl="1" Kind="Bidder" Empty="Yes" ArtChrIdent="-43">
                 <ComplCaption>
                  <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Anlage (Bezeichnung/Ort) </span>
                 </ComplCaption>
                 <ComplBody>
                  <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;....................................................&#x27;</span>
                 </ComplBody>
                 <ComplTail>
                  <br/>
                  <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">vom Bieter einzutragen,</span>
                 </ComplTail>
                </TextComplement>
                <br/>
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Vergütung der Entsorgung übernimmt AN.</span>
               </p>
              </Text>
             </DetailTxt>
             <OutlineText>
              <OutlTxt>
               <TextOutlTxt>
                <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                 <span>Abfall nicht gefährlich AVV170201 schadstoffbelastet LKW AN transp. entsorgen Vergüt.Entsorg. AN</span>
                </p>
               </TextOutlTxt>
              </OutlTxt>
             </OutlineText>
             <!-- GAEB version used: 330 -->
             <!-- GAEB version used: 330 -->
            </CompleteText>
