          </CtlgAssign>
          <Description ID="R20210517144617293000242">
           <WICNo>Muster-LV/40.1/10.10.0020. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Gleisbaumaschine bereitstellen, Bettungsreinigungsmaschine, mit Bedienungspersonal, Schienenwege-Nutzungsentgelte werden mit dem Einheitspreis abgegolten.</span>
              </p>
