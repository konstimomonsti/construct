           <SubDNo>2</SubDNo>
           <Description ID="R20210517144623149000293">
            <WICNo>Muster-LV/40.1/10.20.0280. -U:2</WICNo>
            <CompleteText>
             <DetailTxt>
              <Text>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Mobile Toilette mit Handwaschbecken, mit Urinal, mit Seifenspender, mit Papierhandtuchhalter, mit Toilettenpapierhalter, mit Beleuchtung, vorhalten, einschl. wöchentlicher Leerung und Reinigung, </span>
                <br/>
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Positionsmenge = Produkt aus ....................................................</span>
                <br/>
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">(Vorhaltemenge)</span>
                <br/>
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">mal ....................................................</span>
                <br/>
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">(Vorhaltedauer).</span>
               </p>
              </Text>
             </DetailTxt>
             <OutlineText>
              <OutlTxt>
               <TextOutlTxt>
                <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                 <span>mobile Toilette vorhalten</span>
                </p>
               </TextOutlTxt>
              </OutlTxt>
             </OutlineText>
             <!-- GAEB version used: 330 -->
             <!-- GAEB version used: 330 -->
            </CompleteText>
           </Description>
           <QtySpec>Yes</QtySpec>
           <Qty>0.000</Qty>
           <QU>----</QU>
          </SubDescr>
         </Item>
         <Item ID="AAAAAAABIOKOJFFA" RNoPart="0290">
          <Qty>1.000</Qty>
          <QU>Stk</QU>
          <Description ID="R20210517144623304000294">
           <WICNo>Muster-LV/40.1/10.20.0290. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Eingleisstelle für den AG herstellen, vorhalten und zurückbauen,inklusive Zufahrt, Aufstelllänge des Fahrzeugs bis 12m, Gewicht des Fahrzeugs bis 28t,Hebe- und Fahrzeuge stellt der AN, inkl. Lieferung, Abtransport und allen erforderlichen Ladearbeiten</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Eingleisstelle für AG herstellen</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIOKOLECI" RNoPart="0300">
          <Qty>1.000</Qty>
          <QU>m</QU>
          <Description ID="R20210517144623411000295">
           <WICNo>Muster-LV/40.1/10.20.0300. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Kabeltrogstrecken ( Kabelkanal b= 0 ,10m - 0 ,40m ) während</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">der Bauzeit vor Beschädigungen schützen ( mit Holzbohlen</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">o. ä). gegen kippen sichern</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Kabelkanal sichern</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIOKONCLI" RNoPart="0310">
          <Qty>1.000</Qty>
          <QU>Stk</QU>
          <Description ID="R20210517144623518000296">
           <WICNo>Muster-LV/40.1/10.20.0310. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Sicherung Schachtoberteil</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Schachtoberteil einschl. Deckel bis 1,20 m während der Bauzeit vor Beschädigungen schützen ( mit Holzbohlen o. ä . )</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Schachtdeckel sichern</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIOKOPBCI" RNoPart="0320">
          <LumpSumItem>Yes</LumpSumItem>
          <Qty>1.000</Qty>
          <QU>psch</QU>
          <Description ID="R20210517144623628000297">
           <WICNo>Muster-LV/40.1/10.20.0320. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">LST- Material (Neustoffe und Altstoffe) , in Gitterboxen</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">gelagert, von Bahnwagen abladen bzw. vom Lagerplatz</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">des Nbez. zur Montagestelle und von der Demontagestelle</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">zum Lagerplatz des Nbez. t ransportieren, einschließlich</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">auf- und abladen der Gitterboxen nach Anweisung des</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Fachdienst LST, einschließlich Längstransport innerhalb der Baustelle.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>LST - Material transportieren, abladen</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
