               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Gleisbaumaschine bereitstellen Gleisumbauzug</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIOJAFMCI" RNoPart="0020">
          <LumpSumItem>Yes</LumpSumItem>
          <Qty>1.000</Qty>
          <QU>psch</QU>
          <CtlgAssign>
           <CtlgID>AAAAAAABIOKJJEBI</CtlgID>
