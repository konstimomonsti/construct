                <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                 <span>TL 889.0061 (DBS 918 061)</span>
                </p>
               </TextOutlTxt>
              </OutlTxt>
             </OutlineText>
             <!-- GAEB version used: 330 -->
             <!-- GAEB version used: 330 -->
            </CompleteText>
           </Description>
           <QtySpec>Yes</QtySpec>
           <Qty>0.000</Qty>
          </SubDescr>
         </Item>
         <Item ID="AAAAAAABIOJAKMHI" RNoPart="0040">
          <LumpSumItem>Yes</LumpSumItem>
          <Qty>1.000</Qty>
          <QU>psch</QU>
          <CtlgAssign>
           <CtlgID>AAAAAAABIOKJJEBI</CtlgID>
           <CtlgCode>097</CtlgCode>
          </CtlgAssign>
          <Description ID="R20210517144617453000243">
           <WICNo>Muster-LV/40.1/10.10.0040. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Gleisbaumaschine bereitstellen, Planumsverbesserungsmaschine, mit Bedienungspersonal, Schienenwege-Nutzungsentgelte werden mit dem Einheitspreis abgegolten.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Gleisbaumaschine bereitstellen Planumsverbesserungsmaschine</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIOJAMKNI" RNoPart="0050">
          <LumpSumItem>Yes</LumpSumItem>
          <Qty>1.000</Qty>
          <QU>psch</QU>
          <CtlgAssign>
           <CtlgID>AAAAAAABIOKJJEBI</CtlgID>
           <CtlgCode>097</CtlgCode>
          </CtlgAssign>
          <Description ID="R20260305142522868000003">
           <WICNo>Muster-LV/40.1/10.10.0050. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Baustellenlogistik für Hauptarbeiten, </span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Heran- und abführen von Baumaschinen und Personal, Transport von Abfällen und Stoffen, zwischen Übergabe-/Güterverkehrsstelle und Einbaustelle, Montage-/Demontageplatz und Verwendungsstelle einschl. Transportmittel (Wagen und Triebfahrzeug mit Betriebsstoffen), und Personal einschl. Rangierbegleiter und Triebfahrzeugführer (Tf), </span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">einschl. Telekommunikationsmöglichkeiten für Beteiligte, </span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Gestellen aller Transportmittel, einschl. Fahrpläne und Überwachung des Zuglaufs von Material, Transportmittel und schienengebundenen Maschinen, </span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Vorbereiten, Erstellen und Aktualisieren des Betriebsablaufplanes einschl. aller erforderlichen Einsatzpläne, </span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Baustellenlogistik gilt für Bauabschnitt dieses Loses.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Baustellenlogistik für Hauptarbeiten</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIOJAOOHI" RNoPart="0060">
          <LumpSumItem>Yes</LumpSumItem>
          <Qty>1.000</Qty>
          <QU>psch</QU>
          <CtlgAssign>
           <CtlgID>AAAAAAABIOKJJEBI</CtlgID>
           <CtlgCode>097</CtlgCode>
          </CtlgAssign>
          <Description ID="R20210517144617619000244">
           <WICNo>Muster-LV/40.1/10.10.0060. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Baustellenlogistik  für Stopfgang nach techn. Notwendigkeit, </span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Heran- und abführen von Baumaschinen und Personal, Transport von Stoffen, zwischen Übergabe-/Güterverkehrsstelle und Einbaustelle, Montage-/Demontageplatz und Verwendungsstelle einschl. Transportmittel (Wagen und Triebfahrzeug mit Betriebsstoffen), und Personal einschl. Rangierbegleiter und Triebfahrzeugführer (Tf), </span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">einschl. Telekommunikationsmöglichkeiten für Beteiligte, </span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Gestellen aller Transportmittel, einschl. Fahrpläne und Überwachung des Zuglaufs von Material, Transportmittel und schienengebundenen Maschinen, </span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Vorbereiten, Erstellen und Aktualisieren des Betriebsablaufplanes einschl. aller erforderlichen Einsatzpläne, </span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Baustellenlogistik gilt für Bauabschnitt dieses Loses.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Baustellenlogistik für Stopfgang nach techn. Notwendigkeit</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
        </Itemlist>
       </BoQBody>
      </BoQCtgy>
      <BoQCtgy ID="AAAAAAABIOJCBALI" RNoPart="15">
       <LblTx>
        <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
         <span>Absteckung und Abnahmemessung</span>
        </p>
       </LblTx>
       <BoQBody>
        <Itemlist>
         <Item ID="AAAAAAABIOJCCDGA" RNoPart="0010">
          <Qty>1.000</Qty>
          <QU>m</QU>
          <Description ID="R20210517144617791000246">
           <WICNo>Muster-LV/40.1/10.15.0010. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Absteckung durchführen,</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">nach Ausführungsunterlagen des AG.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Durch den AN sind sämtliche Absteckleistungen, die zur</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Durchführung der Baumaßnahme notwendig sind, in Eigenregie</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">durchzuführen. einschl. aller Nebenleistungen.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Der AG übergibt dem AN ein baustellennahes Festpunktfeld zur</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Absteckung der Hauptachsen, Festpunkt- und Trassendaten</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Im Format .KF (Festpunkte), .TRA (Trassen), .GRA (Gradienten)</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Plandaten im digitalen Format .TIF, .DGN, .DWG, .PDF. </span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Der AG übergibt die Daten vor Baubeginn.</span>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Die Festpunkte sind vor der Absteckung auf ihre unveränderte Lage und Höhe zu überprüfen. Sie sind während der Umbauarbeiten freizuhalten und zu sichern.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Absteckung durchführen,</span>
                <br/>
                <span>nach</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIOJCEENI" RNoPart="0020">
          <Qty>1.000</Qty>
          <QU>m</QU>
          <Description ID="R20210517144617934000247">
           <WICNo>Muster-LV/40.1/10.15.0020. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Geodätische Abnahme Vermessung - Gleise </span>
              </p>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Durchführung der Geodätischen Abnahmevermessung im Bereich des Gleisumbaus mit den zum Umbau verwendeten Festpunkten und Trassen/Gradienten inkl. Erstellung und Übergabe der Messergebnisse gemäß Ril 883.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Geodätische Abnahme Vermessung - Gleise</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
          <SumDescr>Yes</SumDescr>
          <SubDescr>
           <SubDNo>1</SubDNo>
           <Description ID="R20230316135101682000005">
            <WICNo>Muster-LV/40.1/10.15.0020. -U:1</WICNo>
            <CompleteText>
             <DetailTxt>
              <Text>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Die geodätische Abnahmevermessung muss von einem unabhängigen Vermessungsbüro durchgeführt werden. Das Vermessungsbüro darf nicht die Bauabsteckung durchgeführt haben.</span>
               </p>
              </Text>
             </DetailTxt>
             <OutlineText>
              <OutlTxt>
               <TextOutlTxt>
                <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                 <span>Durchführung geodätische Abnahmevermessung</span>
                </p>
               </TextOutlTxt>
              </OutlTxt>
             </OutlineText>
             <!-- GAEB version used: 330 -->
             <!-- GAEB version used: 330 -->
            </CompleteText>
           </Description>
           <QtySpec>Yes</QtySpec>
           <Qty>0.000</Qty>
          </SubDescr>
         </Item>
         <Item ID="AAAAAAABIOJCHHGI" RNoPart="0030">
          <Qty>1.000</Qty>
