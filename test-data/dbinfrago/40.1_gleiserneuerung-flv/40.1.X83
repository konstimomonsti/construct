               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Gleisbaumaschine bereitstellen Bettungsreinigungsmaschine</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
         </Item>
         <Item ID="AAAAAAABIOJAHKHI" RNoPart="0030">
          <LumpSumItem>Yes</LumpSumItem>
          <Qty>1.000</Qty>
          <QU>psch</QU>
          <Description ID="R20230313120003286000001">
           <WICNo>Muster-LV/40.1/10.10.0030. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Gleisbaumaschine bereitstellen, Bettungsaufbereitungmaschine, mit Bedienungspersonal, Schienenwege-Nutzungsentgelte werden mit dem Einheitspreis abgegolten.      </span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Gleisbaumaschine bereitstellen Bettungsaufbereitungsmaschine</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
          <SumDescr>Yes</SumDescr>
          <SubDescr>
           <SubDNo>1</SubDNo>
           <Description ID="R20230313120357668000002">
            <WICNo>Muster-LV/40.1/10.10.0030. -U:1</WICNo>
            <CompleteText>
             <DetailTxt>
              <Text>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Gleisgebundene Bettungsaufbereitungmaschine für die Herstellung von aufgearbeitetem Schotter gemäß  TL 889.0061 (DBS 918 061)</span>
               </p>
              </Text>
             </DetailTxt>
             <OutlineText>
              <OutlTxt>
