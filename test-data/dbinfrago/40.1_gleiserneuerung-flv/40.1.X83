           <WICNo>Muster-LV/40.1/10.20.0280. </WICNo>
           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Bürocontainer, vorhalten, Reinigung wird gesondert vergütet, zur Nutzung durch den AG, beheizbar, elektrisch, Energiekosten werden gesondert vergütet, doppelwandig, wärmegedämmt, Einzelcontainer-Länge 6 m, Einzelcontainer-Breite bis 2,5 m, für Büro einschl. Wasch- und Toilettenraum, ein WC, 2 Arbeitsplätze, Raum eingerichtet, mit einem Tisch, Maße L/B 0,8/1,2 m,</span>
               <br/>
               <TextComplement MarkLbl="1" Kind="Owner" ArtChrIdent="-6476">
                <ComplCaption>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Positionsmenge = Produkt aus </span>
                </ComplCaption>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;1....................................................&#x27;</span>
                </ComplBody>
                <ComplTail>
                 <br/>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">(Vorhaltemenge)</span>
                </ComplTail>
               </TextComplement>
               <br/>
               <TextComplement MarkLbl="2" Kind="Owner" ArtChrIdent="-6477">
                <ComplCaption>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">mal </span>
                </ComplCaption>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;1....................................................&#x27;</span>
                </ComplBody>
                <ComplTail>
                 <br/>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">(Vorhaltedauer)</span>
                </ComplTail>
               </TextComplement>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Bürocontainer vorhalten doppelwandig wärmegedämmt L 6m B 2,5m Büro Wasch-Toilettenraum</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
            <!-- GAEB version used: 330 -->
            <!-- GAEB version used: 330 -->
           </CompleteText>
          </Description>
          <SumDescr>Yes</SumDescr>
          <SubDescr>
           <SubDNo>1</SubDNo>
           <Description ID="R20210517144623042000292">
            <WICNo>Muster-LV/40.1/10.20.0280. -U:1</WICNo>
            <CompleteText>
             <DetailTxt>
              <Text>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">einschließlich Energiekosten und tägliche Reinigung</span>
               </p>
              </Text>
             </DetailTxt>
             <OutlineText>
              <OutlTxt>
               <TextOutlTxt>
                <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                 <span>einschließlich Energiekosten und</span>
                </p>
               </TextOutlTxt>
              </OutlTxt>
             </OutlineText>
             <!-- GAEB version used: 330 -->
             <!-- GAEB version used: 330 -->
            </CompleteText>
           </Description>
