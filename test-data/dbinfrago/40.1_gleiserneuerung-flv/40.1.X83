           <CompleteText>
            <ComplTSA>Yes</ComplTSA>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Planum verbessern, im Fließbandverfahren, bei vorh. Oberbau, Gesamtabgrabungstiefe über 80 bis 85 cm, gemessen von Schwellenoberkante, Ausbaubreite über 5 bis 5,5 m, Bettung ausbauen, reinigen, einbauen und verdichten, Unterbauschichten ausbauen, Planumsschutzschicht einbauen, ebnen und verdichten, Verformungsmodul mind. EV2 50 MPa, Einbaubreite über 4,5 bis 5 m, wasserundurchlässig (KG I), Schichtdicke 30 cm, Bettungsrückstand und Unterbauschichten auf Materialförder-, Silowagen vor Kopf verladen, einschl. absetzen,</span>
               <br/>
               <TextComplement MarkLbl="1" Kind="Owner" ArtChrIdent="-7015">
                <ComplCaption>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Boden gemäß geotechnischen Gutachten </span>
                </ComplCaption>
                <ComplBody>
                 <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">&#x27;1....................................................&#x27;</span>
                </ComplBody>
                <ComplTail/>
               </TextComplement>
               <br/>
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Transportweg über 5 bis 10 km, Oberfläche des freigelegten Bahnkörpers ebnen und verdichten, Verformungsmodul mind. EV2 20 MPa, Fahrzeuge stellt der AN.</span>
              </p>
             </Text>
            </DetailTxt>
            <OutlineText>
             <OutlTxt>
              <TextOutlTxt>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span>Planum verbessern Fließbandverfahren Oberbau vorh. ausbauen reinigen einbauen verd. Unterbauschichten ausbauen KGI</span>
               </p>
              </TextOutlTxt>
             </OutlTxt>
            </OutlineText>
