                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Einschließlich Verteilung von Handzetteln,</span>
               </p>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">gemäß der behördlichen Auflagen bzw.</span>
               </p>
               <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
                <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">auf Anordnung des AG an die Anwohner.</span>
               </p>
              </Text>
             </DetailTxt>
             <OutlineText>
              <OutlTxt>
               <TextOutlTxt>
                <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
