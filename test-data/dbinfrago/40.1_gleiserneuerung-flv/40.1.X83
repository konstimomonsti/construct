          <Description ID="R20210517144623789000298">
           <WICNo>Muster-LV/40.1/10.20.0330. </WICNo>
           <CompleteText>
            <DetailTxt>
             <Text>
              <p style="text-align:left;margin-top:0pt;margin-bottom:0pt;">
               <span style="font-family:Arial;font-size:10pt;Color:rgb(0,0,0);">Kabelkanal ( Kabelkanal b= 0 ,10m - 0 ,40m ) bauzeitlich verlegen und nach Umbauende ordnungsgemäß wieder herstellen</span>
              </p>
             </Text>
            </DetailTxt>
