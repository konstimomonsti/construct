POSTGRES_DB=construction
POSTGRES_USER=construction
POSTGRES_PASSWORD=
POSTGRES_APP_PASSWORD=
POSTGRES_PORT=5432
BACKEND_PORT=8080
# Frontend build output folder inside frontend/.
FRONTEND_DIST=dist
# Separate frontend dev server origins allowed to POST, comma separated (e.g. http://localhost:5173).
ALLOWED_ORIGINS=

# Production (compose.prod.yaml) uses .env.prod, written by ./backend/deploy/deploy.sh init:
# APP_DOMAIN=tenders.example.com
# BASIC_AUTH_USER=tender
# BASIC_AUTH_HASH='$2a$14$...'   # bcrypt; keep the single quotes
# SITE_ADDRESS=                  # defaults to APP_DOMAIN
# FRONTEND_DIST=dist             # build output of frontend/ when it has a package.json
# HTTP_PORT=80
# HTTPS_PORT=443
# BACKUP_KEEP_DAYS=14

# Optional production risk assessment settings (put these in .env.prod).
# ANALYSIS_L3_PROVIDER=none      # none, ollama, or anthropic
# ANALYSIS_L3_MODEL=
# OLLAMA_HOST=http://ollama:11434
# ANTHROPIC_API_KEY=
# ANALYSIS_L3_MAX_CALLS=4
# ANALYSIS_L3_TIMEOUT=45
# Typo checks (layer 1) need `pip install spylls` and a local German hunspell dictionary (GPL, not shipped).
# MiKTeX and /usr/share/hunspell (apt install hunspell-de-de) are found automatically; "off" disables it.
# ANALYSIS_SPELL_DIC=/usr/share/hunspell/de_DE.dic
