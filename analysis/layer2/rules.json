      {"DependencyName": "Reinforcement steel", "Regex": "(?i)\\b(betonstahl|baustahl|bewehrung|matten|bst\\s*500)\\b", "CheckType": "Boolean", "SuggestedText": "Betonstahl / Bewehrung gemäß Statik"},
      {"DependencyName": "Clean layer", "Regex": "(?i)\\b(sauberkeitsschicht|pe-folie)\\b", "CheckType": "Boolean", "TriggerRegex": "(?i)\\b(bodenplatte|floor\\s+slab)\\b", "SuggestedText": "Sauberkeitsschicht / PE-Folie unter Bodenplatte"}
    ]
  },
  {
